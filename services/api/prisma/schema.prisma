enum TransferStatus {
  pending
  initiated
  processed
  failed
  reversed

  @@map("transfer_status")
}

// The split is amount = commission + razorpay fee + payout, by construction in
// calculateSplit(). A CHECK says so, which means a transfer whose parts do not
// add up to the whole cannot be recorded - a wrong commission rate is refused at
// the point of the mistake rather than found later in a reconciliation.
model MarketplaceTransfer {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  organizerId String  @map("organizer_id")
  paymentId   String  @map("payment_id")
  transferId  String? @unique @map("transfer_id") // Razorpay transfer id

  amount            Decimal @db.Decimal(14, 2)
  commissionAmount  Decimal @map("commission_amount") @db.Decimal(14, 2)
  razorpayFeeAmount Decimal @map("razorpay_fee_amount") @db.Decimal(14, 2)
  payoutAmount      Decimal @map("payout_amount") @db.Decimal(14, 2)

  status        TransferStatus @default(pending)
  holdUntil     DateTime?      @map("hold_until")
  processedAt   DateTime?      @map("processed_at")
  failureReason String?        @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([organizerId, createdAt])
  @@map("marketplace_transfers")
}

enum RefundStatus {
  pending
  processed
  failed

  @@map("refund_status")
}

model MarketplaceRefund {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  paymentId String  @map("payment_id")
  refundId  String? @unique @map("refund_id") // Razorpay refund id

  amount           Decimal      @db.Decimal(14, 2)
  currency         String       @default("INR") @db.VarChar(3)
  reason           String?
  reversedTransfer Boolean      @default(false) @map("reversed_transfer")
  status           RefundStatus @default(pending)
  createdBy        String?      @map("created_by")
  processedAt      DateTime?    @map("processed_at")
  failureReason    String?      @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("marketplace_refunds")
}

