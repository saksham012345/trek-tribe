  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatSessionMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("chat_sessions")
}

enum ChatSender {
  user
  ai
  agent

  @@map("chat_sender")
}

// totalMessages was a counter beside the embedded array. It is a count of these
// rows now, for the same reason memberCount was dropped in wave 5.
model ChatSessionMessage {
  id        String     @id @default(uuid())
  sessionId String     @map("session_id")
  sender    ChatSender
