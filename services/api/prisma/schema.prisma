enum ChatMessageType {
  text
  image
  file
  system

  @@map("chat_message_type")
}

enum ChatMessageRelatedType {
  trip
  booking
  ticket

  @@map("chat_message_related_type")
}

model ChatMessage {
  id             String                 @id @default(uuid())
  conversationId String                 @map("conversation_id")
  senderId       String                 @map("sender_id")
  senderType     ChatMessageSenderType  @map("sender_type")
  recipientId    String?                @map("recipient_id")
  recipientType  ChatMessageSenderType? @map("recipient_type")
  message        String
