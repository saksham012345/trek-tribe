generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VendorCategory {
  hotel
  homestay
  campsite
  transport
  driver
  guide
  trek_leader
  equipment_rental
  food
  photographer
  videographer
  permit_agency
  emergency_contact
  custom

  @@map("vendor_category")
}

enum VendorAvailability {
  available
  busy
  unavailable

  @@map("vendor_availability")
}

model Vendor {
  id                  String             @id @default(uuid())
  organizerId         String             @map("organizer_id")
  businessName        String             @map("business_name")
  contactPerson       String?            @map("contact_person")
  phone               String?
  email                String?
  whatsappNumber      String?            @map("whatsapp_number")
  category            VendorCategory
  customCategoryLabel String?            @map("custom_category_label")
  address             String?
  gstNumber           String?            @map("gst_number")
  pricingNotes        String?            @map("pricing_notes")
  rating              Decimal?
  availabilityStatus  VendorAvailability @default(available) @map("availability_status")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  documents         VendorDocument[]
  assignments       TripVendorAssignment[]
  communicationLogs VendorCommunicationLog[]

  @@index([organizerId])
  @@map("vendors")
}

model VendorDocument {
  id         String   @id @default(uuid())
  vendorId   String   @map("vendor_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model TripVendorAssignment {
  id         String         @id @default(uuid())
  tripId     String         @map("trip_id")
  vendorId   String         @map("vendor_id")
  category   VendorCategory
  assignedAt DateTime       @default(now()) @map("assigned_at")

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payment VendorPayment?

  @@index([tripId])
  @@index([vendorId])
  @@map("trip_vendor_assignments")
}

enum VendorPaymentStatus {
  pending
  partial
  paid
  overdue

  @@map("vendor_payment_status")
}

model VendorPayment {
  id          String              @id @default(uuid())
  assignmentId String             @unique @map("assignment_id")
  totalAmount Decimal             @map("total_amount")
  paidAmount  Decimal             @default(0) @map("paid_amount")
  dueDate     DateTime?           @map("due_date")
  status      VendorPaymentStatus @default(pending)
  recordedAt  DateTime            @default(now()) @map("recorded_at")

  assignment TripVendorAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  history    VendorPaymentHistory[]

  @@map("vendor_payments")
}

model VendorPaymentHistory {
  id              String   @id @default(uuid())
  vendorPaymentId String   @map("vendor_payment_id")
  amount          Decimal
  paidAt          DateTime @default(now()) @map("paid_at")
  note            String?

  vendorPayment VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)

  @@index([vendorPaymentId])
  @@map("vendor_payment_history")
}

enum VendorEventType {
  vendor_payment_completed
  pre_departure_reminder

  @@map("vendor_event_type")
}

model VendorEvent {
  id          String          @id @default(uuid())
  tripId      String          @map("trip_id")
  eventType   VendorEventType @map("event_type")
  payload     Json
  createdAt   DateTime        @default(now()) @map("created_at")
  processedAt DateTime?       @map("processed_at")

  @@index([processedAt])
  @@map("vendor_events")
}

enum VendorCommunicationStatus {
  sent
  failed
  pending

  @@map("vendor_communication_status")
}

model VendorCommunicationLog {
  id            String                    @id @default(uuid())
  assignmentId  String?                   @map("assignment_id")
  vendorId      String                    @map("vendor_id")
  eventType     VendorEventType           @map("event_type")
  status        VendorCommunicationStatus @default(pending)
  sentAt        DateTime?                 @map("sent_at")
  emailSnapshot String                    @map("email_snapshot")
  createdAt     DateTime                  @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([assignmentId])
  @@map("vendor_communication_log")
}

// Migrated from the Mongoose Follow model (D10/D11, wave 1 pilot).
// followerId/followingId hold Mongo ObjectIds as strings. They cannot be foreign
// keys until User lands in wave 9, at which point they become real FKs.
model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

enum WishlistPriority {
  low
  medium
  high

  @@map("wishlist_priority")
}

// Migrated from the Mongoose Wishlist model (D10/D11, wave 2).
// userId/tripId hold Mongo ObjectIds as strings - no FK until User and Trip land.
model Wishlist {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tripId    String           @map("trip_id")
  notes     String?
  priority  WishlistPriority @default(medium)
  tags      String[]         @default([]) @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([userId, tripId])
  @@index([userId])
  @@index([tripId])
  @@index([userId, priority, createdAt])
  @@map("wishlists")
}

enum UserActivityActorType {
  user
  organizer

  @@map("user_activity_actor_type")
}

enum UserActivityType {
  trip_view
  trip_created
  booking_made
  chat_initiated
  ticket_created
  payment_made
  profile_updated
  document_uploaded
  login
  logout

  @@map("user_activity_type")
}

// Migrated from the Mongoose UserActivity model (D10/D11, wave 2).
// userId holds a Mongo ObjectId as a string - no FK until User lands in wave 9.
// The Mongoose schema had no updatedAt, and this table keeps it that way: an
// activity record is an append-only fact about something that already happened.
model UserActivity {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  userType     UserActivityActorType @map("user_type")
  activityType UserActivityType      @map("activity_type")
  description  String
  // Was a nested Mongoose sub-document of mixed types (tripId, bookingId,
  // ticketId, paymentId, amount, ipAddress, userAgent, location). Kept as JSON
  // rather than flattened into columns: nothing queries inside it today, and
  // inventing eight nullable columns for that would be worse than honest JSON.
  metadata     Json                  @default("{}")
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([activityType])
  @@index([createdAt])
  @@map("user_activities")
}

enum PostType {
  trip_memory
  general_post
  link_share
  experience

  @@map("post_type")
}

// Migrated from the Mongoose Post model (D10/D11, wave 2).
// Post and Comment moved together: Comment.postId points at Post and Post held a
// comments array pointing back, so neither could be split from the other.
model Post {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  type      PostType
  title     String   @db.VarChar(200)
  content   String   @db.VarChar(2000)
  images    String[] @default([])
  // Arrays of objects in the Mongoose schema. Nothing queries inside them, so
  // they stay JSON rather than becoming child tables nobody joins to.
  links     Json     @default("[]")
  tripData  Json?    @map("trip_data")
  tags      String[] @default([]) @db.VarChar(30)
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The Mongoose Post carried a `comments: ObjectId[]` alongside Comment.postId -
  // the same fact written twice, which is what DoD-3 warns about. The array is
  // gone; this relation is the single source of truth.
  comments Comment[]
  likes    PostLike[]

  @@index([authorId])
  @@index([type])
  @@index([isPublic])
  @@map("posts")
}

// Was `likes: ObjectId[]` on the post. As an array, "one like per user" could
// only ever be a check in application code. Here it is a unique constraint.
model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// Migrated from the Mongoose Comment model (D10/D11, wave 2).
model Comment {
  id              String   @id @default(uuid())
  postId          String   @map("post_id")
  authorId        String   @map("author_id")
  content         String   @db.VarChar(500)
  parentCommentId String?  @map("parent_comment_id")
  isEdited        Boolean  @default(false) @map("is_edited")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentComment Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")
  likes         CommentLike[]

  @@index([postId])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

enum ReviewType {
  trip
  organizer

  @@map("review_type")
}

enum ReviewTag {
  safety
  value_for_money
  organization
  communication
  accommodation
  food
  activities
  guide_quality
  group_size
  timing
  location
  equipment

  @@map("review_tag")
}

// Migrated from the Mongoose Review model (D10/D11, wave 2). The largest domain
// in this wave: 9 consumer files.
//
// The duplicate-review rule was a pre-save hook doing findOne-then-throw. That is
// a race between two concurrent requests, and it is skipped entirely by any write
// that does not go through .save(). It is @@unique here.
model Review {
  id         String     @id @default(uuid())
  reviewerId String     @map("reviewer_id")
  targetId   String     @map("target_id")
  reviewType ReviewType @map("review_type")
  rating     Int
  title      String     @db.VarChar(100)
  comment    String     @db.VarChar(1000)
  images     String[]   @default([])
  // The Mongoose tags were a closed list, so they are an enum rather than free
  // text: a typo used to be stored happily and silently never matched a filter.
  tags       ReviewTag[] @default([])
  isVerified Boolean    @default(false) @map("is_verified")

  // organizerResponse was a nested object of a fixed shape, so it is two columns
  // rather than JSON - both are queryable and neither can drift from the other.
  organizerResponseMessage     String?   @map("organizer_response_message") @db.VarChar(500)
  organizerResponseRespondedAt DateTime? @map("organizer_response_responded_at")

  tripDate DateTime? @map("trip_date")
  userId   String?   @map("user_id")
  tripId   String?   @map("trip_id")

  verifiedAt        DateTime? @map("verified_at")
  verifiedBy        String?   @map("verified_by")
  verificationNotes String?   @map("verification_notes")

  isRejected      Boolean   @default(false) @map("is_rejected")
  rejectedAt      DateTime? @map("rejected_at")
  rejectedBy      String?   @map("rejected_by")
  rejectionReason String?   @map("rejection_reason")

  isFlagged Boolean   @default(false) @map("is_flagged")
  flaggedAt DateTime? @map("flagged_at")

  moderatedAt     DateTime? @map("moderated_at")
  moderatedBy     String?   @map("moderated_by")
  moderationNotes String?   @map("moderation_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  helpfulVotes ReviewHelpfulVote[]
  flags        ReviewFlag[]

  @@unique([reviewerId, targetId, reviewType])
  @@index([targetId, reviewType, rating])
  @@index([reviewerId, createdAt])
  @@index([reviewType, isVerified, createdAt])
  @@map("reviews")
}

// Was `helpfulVoters: ObjectId[]` plus a `helpfulVotes: number` kept in step by
// hand in markAsHelpful. Two records of one fact, which is what DoD-3 warns
// about. The count is derived from these rows now, and one vote per user is a
// constraint rather than an includes() check.
model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
}

// Was an array of objects on the review. reviewVerification.ts already checked
// "has this user flagged already" in application code, so the uniqueness was
// intended - it just was not enforced.
model ReviewFlag {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  reason    String
  flaggedAt DateTime @default(now()) @map("flagged_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_flags")
}

// ─── Wave 3: operational leaves (D10/D11) ────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VERIFY
  PAYMENT
  SUSPEND
  APPROVE
  REJECT
  payment_captured
  payment_failed
  subscription_activated
  subscription_charged
  subscription_cancelled
  subscription_paused
  order_paid

  @@map("audit_action")
}

enum AuditResource {
  Trip
  User
  Payment
  Subscription
  Ticket
  Lead
  Review
  Booking
  Auth
  MarketplaceOrder
  MarketplaceTransfer
  MarketplaceRefund

  @@map("audit_resource")
}

enum AuditStatus {
  SUCCESS
  FAILURE
  PENDING

  @@map("audit_status")
}

// The Mongoose schema carried a TTL index dropping rows after 90 days:
//   auditLogSchema.index({ timestamp: 1 }, { expireAfterSeconds: 7776000 })
// Postgres has no TTL. Deleting the index silently would let this table grow
// without bound, so the retention is a scheduled job instead -
// scripts/prune-audit-logs.ts, which must actually be scheduled to run.
model AuditLog {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  userEmail    String?       @map("user_email")
  action       AuditAction
  resource     AuditResource
  resourceId   String?       @map("resource_id")
  changesBefore Json?        @map("changes_before")
  changesAfter  Json?        @map("changes_after")
  metadata     Json          @default("{}")
  timestamp    DateTime      @default(now())
  status       AuditStatus   @default(SUCCESS)
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([userId, timestamp])
  @@index([resource, action, timestamp])
  @@index([timestamp])
  @@map("audit_logs")
}

enum NotificationType {
  ticket
  chat
  verification
  payment
  booking
  lead
  system
  reminder

  @@map("notification_type")
}

enum NotificationPriority {
  low
  medium
  high

  @@map("notification_priority")
}

enum NotificationActionType {
  view_ticket
  view_trip
  make_payment
  verify_trip
  respond_chat
  view_lead

  @@map("notification_action_type")
}

enum NotificationRelatedType {
  ticket
  trip
  booking
  payment
  lead
  chat

  @@map("notification_related_type")
}

model Notification {
  id            String                   @id @default(uuid())
  userId        String                   @map("user_id")
  type          NotificationType
  title         String
  message       String
  priority      NotificationPriority     @default(medium)
  isRead        Boolean                  @default(false) @map("is_read")
  readAt        DateTime?                @map("read_at")
  actionUrl     String?                  @map("action_url")
  actionType    NotificationActionType?  @map("action_type")
  // relatedTo was a nested { type, id } pair. Two columns rather than JSON, so
  // "every unread booking notification" stays a query rather than a scan.
  relatedToType NotificationRelatedType? @map("related_to_type")
  relatedToId   String?                  @map("related_to_id")
  metadata      Json?
  emailSent     Boolean                  @default(false) @map("email_sent")
  emailSentAt   DateTime?                @map("email_sent_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

enum RetryJobStatus {
  pending
  in_progress
  failed
  completed
  cancelled

  @@map("retry_job_status")
}

model RetryJob {
  id          String         @id @default(uuid())
  jobType     String         @map("job_type")
  referenceId String         @map("reference_id")
  payload     Json?
  retryCount  Int            @default(0) @map("retry_count")
  maxRetries  Int            @default(5) @map("max_retries")
  lastAttempt DateTime?      @map("last_attempt")
  nextRetryAt DateTime       @default(now()) @map("next_retry_at")
  status      RetryJobStatus @default(pending)
  lastError   String?        @map("last_error")
  lastResult  String?        @map("last_result")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([referenceId])
  @@index([nextRetryAt, status])
  @@map("retry_jobs")
}

// eventId is unique so a webhook replayed by the provider is recorded once.
// That was already `unique: true` in Mongoose - one of the few invariants in
// this codebase that was a real index rather than a hook.
model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  source      String
  processedAt DateTime? @map("processed_at")
  rawPayload  Json?     @map("raw_payload")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("webhook_events")
}

enum SiteOverlayStyle {
  light
  dark

  @@map("site_overlay_style")
}

// A singleton. `key` is unique and only ever holds 'global', which is how the
// Mongoose model expressed it too - kept so upsert-by-key still works.
model SiteSettings {
  id  String @id @default(uuid())
  key String @unique @default("global")

  homeHeroImages            String[]         @default([]) @map("home_hero_images")
  homeOverlayStyle          SiteOverlayStyle @default(light) @map("home_overlay_style")
  homeFontFamily            String           @default("system-ui, -apple-system, Segoe UI, Roboto, sans-serif") @map("home_font_family")
  homeDiscoverColumnsDesktop Int             @default(3) @map("home_discover_columns_desktop")
  homeDiscoverColumnsMobile  Int             @default(2) @map("home_discover_columns_mobile")

  contactSupportEmail String @default("support@trektribe.com") @map("contact_support_email")
  contactOtpFromEmail String @default("support@trektribe.com") @map("contact_otp_from_email")
  contactBookingFromEmail String @default("support@trektribe.com") @map("contact_booking_from_email")

  notificationsEmailEnabled        Boolean @default(true) @map("notifications_email_enabled")
  notificationsSmsEnabled          Boolean @default(false) @map("notifications_sms_enabled")
  notificationsSendFollowerAlerts  Boolean @default(true) @map("notifications_send_follower_alerts")
  notificationsTripReminderHours   Int     @default(24) @map("notifications_trip_reminder_hours")

  integrationsPaymentProvider String  @default("razorpay") @map("integrations_payment_provider")
  integrationsEmailProvider   String  @default("sendgrid") @map("integrations_email_provider")
  integrationsSmsProvider     String  @default("disabled") @map("integrations_sms_provider")
  integrationsTwilioFromNumber String  @default("") @map("integrations_twilio_from_number")

  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─── Wave 4: CRM (D10/D11) ───────────────────────────────────────────────────

enum LeadSource {
  trip_view
  inquiry
  partial_booking
  chat
  form
  other

  @@map("lead_source")
}

enum LeadStatus {
  new
  contacted
  interested
  not_interested
  converted
  lost

  @@map("lead_status")
}

enum LeadPipelineStage {
  new
  contacted
  interested
  negotiating
  booked
  lost

  @@map("lead_pipeline_stage")
}

enum LeadKycStatus {
  pending
  verified
  rejected
  not_required

  @@map("lead_kyc_status")
}

// Migrated from the Mongoose Lead model (D10/D11, wave 4).
//
// The Mongoose schema declared `index({ email: 1, assignedTo: 1 })` with the
// comment "compound for dedup" - but the index was not unique. The actual dedup
// was databaseImportService.checkDuplicate(), a findOne before an insert, run in
// a loop by the import worker. Two imports racing each other produced duplicates
// that nothing rejected. It is a unique constraint here.
//
// Postgres treats NULLs as distinct in a unique index, which is what this needs:
// leads with no assignedTo are unassigned, and two unassigned leads sharing an
// email are not duplicates of each other.
model Lead {
  id            String            @id @default(uuid())
  userId        String?           @map("user_id")
  tripId        String?           @map("trip_id")
  email         String
  phone         String?
  name          String?
  source        LeadSource
  status        LeadStatus        @default(new)
  leadScore     Int               @default(0) @map("lead_score")
  pipelineStage LeadPipelineStage @default(new) @map("pipeline_stage")

  // Flat columns for the parts that are queried or reported on...
  tripViewCount  Int       @default(0) @map("trip_view_count")
  lastVisitedAt  DateTime? @map("last_visited_at")
  inquiryMessage String?   @map("inquiry_message")
  tags           String[]  @default([])
  notes          String?
  kycStatus      LeadKycStatus @default(pending) @map("kyc_status")

  // ...and JSON for the parts that are only ever read back whole. Splitting
  // travelerDetails into six nullable columns nothing filters on would be
  // ceremony, not clarity.
  partialFormData Json? @map("partial_form_data")
  travelerDetails Json? @map("traveler_details")
  kycDetails      Json? @map("kyc_details")

  // interactions was an array of { type, description, timestamp } on the
  // document. It is a child table so an interaction can be inserted without
  // rewriting the lead, which is what an append-only log wants.
  interactions LeadInteraction[]
  activities   LeadActivity[]

  assignedTo  String?   @map("assigned_to")
  convertedAt DateTime? @map("converted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([email, assignedTo])
  @@index([email])
  @@index([status])
  @@index([tripId])
  @@index([assignedTo])
  @@index([leadScore])
  @@index([source])
  @@index([pipelineStage])
  @@index([createdAt])
  @@map("leads")
}

enum LeadInteractionType {
  email
  call
  chat
  message
  visit

  @@map("lead_interaction_type")
}

model LeadInteraction {
  id          String              @id @default(uuid())
  leadId      String              @map("lead_id")
  type        LeadInteractionType
  description String
  // The user who logged it. A Mongo ObjectId string, so no foreign key until
  // User lands in wave 9.
  performedBy String?             @map("performed_by")
  timestamp   DateTime            @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, timestamp])
  @@map("lead_interactions")
}

enum LeadEventType {
  trip_viewed
  chat_message
  inquiry_submitted
  email_opened
  booking_started
  booking_abandoned

  @@map("lead_event_type")
}

// leadId is a real foreign key now. In Mongo it was a ref with nothing behind
// it, so an activity could outlive the lead it described.
model LeadActivity {
  id        String        @id @default(uuid())
  leadId    String        @map("lead_id")
  eventType LeadEventType @map("event_type")
  metadata  Json          @default("{}")
  timestamp DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, timestamp])
  @@index([eventType])
  @@map("lead_activities")
}

enum ImportFileType {
  csv
  xlsx
  json

  @@map("import_file_type")
}

enum ImportStatus {
  pending
  processing
  completed
  failed
  partially_completed

  @@map("import_status")
}

model ImportedDatabase {
  id          String         @id @default(uuid())
  organizerId String         @map("organizer_id")
  fileName    String         @map("file_name")
  fileSize    Int            @map("file_size")
  fileType    ImportFileType @map("file_type")
  uploadedAt  DateTime       @default(now()) @map("uploaded_at")
  status      ImportStatus   @default(pending)

  statsTotalRecords     Int @default(0) @map("stats_total_records")
  statsSuccessfulImports Int @default(0) @map("stats_successful_imports")
  statsFailedImports    Int @default(0) @map("stats_failed_imports")
  statsDuplicatesSkipped Int @default(0) @map("stats_duplicates_skipped")
  // Milliseconds the run took. Nullable, because a job still in flight has not
  // taken any time yet.
  statsProcessingTime   Int? @map("stats_processing_time")

  // Variable-shaped lists read back whole by the UI, so JSON rather than
  // child tables nobody joins to.
  fieldMapping Json @default("[]") @map("field_mapping")
  config       Json @default("{}")
  importErrors Json @default("[]") @map("import_errors")

  // How rollback works: the ids of the leads this import created. Without it
  // an import cannot be undone, which is the whole point of the feature.
  importedLeadIds String[] @default([]) @map("imported_lead_ids")

  canRollback  Boolean   @default(true) @map("can_rollback")
  rolledBackAt DateTime? @map("rolled_back_at")

  // Progress tracking, read by the import history panel while a job runs.
  processedRows      Int @default(0) @map("processed_rows")
  totalRows          Int @default(0) @map("total_rows")
  progressPercentage Int @default(0) @map("progress_percentage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([status])
  @@map("imported_databases")
}

// ─── Wave 5: content (D10/D11) ───────────────────────────────────────────────

enum BlogStatus {
  draft
  published

  @@map("blog_status")
}

model BlogPost {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(180)
  slug            String     @unique
  excerpt         String     @db.VarChar(320)
  content         String
  coverImage      String?    @map("cover_image")
  tags            String[]   @default([])
  status          BlogStatus @default(draft)
  publishedAt     DateTime?  @map("published_at")
  authorId        String     @map("author_id")
  readTimeMinutes Int        @default(4) @map("read_time_minutes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@map("blog_posts")
}

enum GroupCategory {
  trekking
  camping
  wildlife
  adventure
  photography
  cycling
  other

  @@map("group_category")
}

// memberCount is gone. It was a number kept in step by hand with the members
// array, and routes/groups.ts sorted on it. Prisma can order by a relation
// count, so the count is derived and cannot drift.
//
// This is the opposite call from socialStats.followersCount, which had to stay:
// that sort runs in Mongo, and a Postgres count cannot serve it. Here both
// sides are in Postgres, so nothing forces the duplicate.
model Group {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  description String        @db.VarChar(1000)
  category    GroupCategory
  coverImage  String?       @map("cover_image")
  creatorId   String        @map("creator_id")
  isPublic    Boolean       @default(true) @map("is_public")
  tags        String[]      @default([]) @db.VarChar(30)
  rules       String?       @db.VarChar(2000)
  location    String?       @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members GroupMember[]

  @@index([creatorId])
  @@index([isPublic])
  @@map("groups")
}

enum GroupRole {
  member
  admin

  @@map("group_role")
}

// Was two arrays, members[] and admins[], with a user appearing in both when
// they were an admin. One row per membership with a role instead, so "is this
// person in the group twice" cannot happen and promoting is an update.
model GroupMember {
  id       String    @id @default(uuid())
  groupId  String    @map("group_id")
  userId   String    @map("user_id")
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

enum EventType {
  trip
  meetup
  workshop
  webinar
  other

  @@map("event_type")
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled

  @@map("event_status")
}

// attendeeCount is gone for the same reason memberCount is.
model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  eventType   EventType   @map("event_type")
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  location    String?
  isVirtual   Boolean     @default(false) @map("is_virtual")
  virtualLink String?     @map("virtual_link")
  organizerId String      @map("organizer_id")
  groupId     String?     @map("group_id")
  coverImage  String?     @map("cover_image")
  capacity    Int?
  status      EventStatus @default(upcoming)
  tags        String[]    @default([])
  price       Decimal?
  isPaid      Boolean     @default(false) @map("is_paid")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  participants EventParticipant[]

  @@index([organizerId])
  @@index([groupId])
  @@index([status])
  @@index([startDate])
  @@map("events")
}

enum EventParticipation {
  attendee
  invitee

  @@map("event_participation")
}

// Was attendees[] and invitees[] as two arrays. One row per person with a kind,
// so the same user cannot sit in both lists at once - which the arrays allowed
// and nothing checked.
model EventParticipant {
  id      String             @id @default(uuid())
  eventId String             @map("event_id")
  userId  String             @map("user_id")
  kind    EventParticipation @default(attendee)
  addedAt DateTime           @default(now()) @map("added_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

enum KnowledgeType {
  faq
  guide
  policy
  trip
  general

  @@map("knowledge_type")
}

model KnowledgeBase {
  id       String        @id @default(uuid())
  title    String        @db.VarChar(200)
  content  String        @db.VarChar(10000)
  summary  String?       @db.VarChar(500)
  type     KnowledgeType
  category String
  tags     String[]      @default([])

  // Vector embeddings, stored as a plain float array because that is what the
  // Mongo version was. ragService loads candidate documents and computes cosine
  // similarity in JavaScript - Mongo never did vector search either - so this is
  // a faithful port. pgvector would make it a real indexed search, but that is
  // new capability rather than a migration, and is not being smuggled in here.
  embedding Float[] @default([])

  metadata       Json    @default("{}")
  context        Json    @default("{}")
  sourceUrl      String? @map("source_url")
  relevanceScore Float   @default(1.0) @map("relevance_score")
  queryCount     Int     @default(0) @map("query_count")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@index([category, isActive])
  @@map("knowledge_base")
}

// ─── Wave 6: support (D10/D11) ───────────────────────────────────────────────

enum SupportCategory {
  booking
  payment
  technical
  general
  complaint
  refund

  @@map("support_category")
}

enum SupportPriority {
  low
  medium
  high
  urgent

  @@map("support_priority")
}

// The Mongoose values carry hyphens: 'in-progress', 'waiting-customer'. A Prisma
// enum member cannot be spelled with one, so the stored label is mapped rather
// than the value being rewritten. That keeps what is already in Mongo valid here,
// so the backfill copies these straight across with no translation - and no row
// arrives carrying a value the column will not accept.
enum SupportStatus {
  open
  in_progress      @map("in-progress")
  waiting_customer @map("waiting-customer")
  resolved
  closed

  @@map("support_status")
}

// A different model with a different lifecycle: Ticket starts at 'pending' and
// can be cancelled, SupportTicket starts at 'open' and cannot. They are not the
// same set and never were - analytics.service.ts counted Ticket rows with
// status 'open', which Ticket has never had, so that half of the count was
// always zero.
enum TicketStatus {
  pending
  in_progress
  waiting_customer
  resolved
  closed
  cancelled

  @@map("ticket_status")
}

enum TicketCategory {
  booking
  payment
  verification
  technical
  inquiry
  complaint
  other

  @@map("ticket_category")
}

enum TicketRequesterType {
  user
  organizer

  @@map("ticket_requester_type")
}

enum TicketSenderType {
  user
  organizer
  admin

  @@map("ticket_sender_type")
}

model Ticket {
  id           String @id @default(uuid())
  // Supplied by ticket_number_seq through a column default.
  ticketNumber String @unique @default(dbgenerated("('TKT-'::text || to_char(now(), 'YYMMDD'::text) || '-'::text || lpad((nextval('ticket_number_seq'::regclass))::text, 4, '0'::text))")) @map("ticket_number")

  subject     String
  description String
  category    TicketCategory
  priority    SupportPriority     @default(medium)
  status      TicketStatus        @default(pending)

  requesterId   String              @map("requester_id")
  requesterType TicketRequesterType @map("requester_type")
  assignedTo    String?             @map("assigned_to")
  tripId        String?             @map("trip_id")
  bookingId     String?             @map("booking_id")

  attachments Json @default("[]")

  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  // Minutes, both of them - analyticsService averages responseTime across
  // tickets that have one.
  responseTime       Int? @map("response_time")
  resolutionTime     Int? @map("resolution_time")
  satisfactionRating Int? @map("satisfaction_rating")

  tags String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation  TicketMessage[]
  internalNotes TicketInternalNote[]

  @@index([requesterId])
  @@index([assignedTo])
  @@index([status])
  @@index([tripId])
  @@map("tickets")
}

// Was an embedded conversation array, same reasoning as support ticket messages:
// a reply is an insert, not a rewrite of the whole ticket.
model TicketMessage {
  id         String           @id @default(uuid())
  ticketId   String           @map("ticket_id")
  senderId   String           @map("sender_id")
  senderType TicketSenderType @map("sender_type")
  message    String
  timestamp  DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp])
  @@map("ticket_messages")
}

// internalNotes on Ticket were objects with an author, unlike SupportTicket's
// plain strings, so they get their own table rather than a String[].
model TicketInternalNote {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  noteBy    String   @map("note_by")
  note      String
  timestamp DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp])
  @@map("ticket_internal_notes")
}

// ticketId was generated in a pre-save hook from countDocuments() + 1 joined to
// a millisecond timestamp. That is a count-based sequence: two tickets created
// in the same millisecond read the same count, build the same id, and the unique
// index then rejects one of them. Postgres has an actual sequence for this - see
// the migration - so the id is assigned by the database and cannot collide.
model SupportTicket {
  id       String @id @default(uuid())
  // The value comes from support_ticket_number_seq via a column default, so
  // Prisma must be told not to require it on create.
  ticketId String @unique @default(dbgenerated("('TT-'::text || to_char(now(), 'YYMMDD'::text) || '-'::text || lpad((nextval('support_ticket_number_seq'::regclass))::text, 4, '0'::text))")) @map("ticket_id")

  userId           String  @map("user_id")
  assignedAgentId  String? @map("assigned_agent_id")
  relatedTripId    String? @map("related_trip_id")
  relatedBookingId String? @map("related_booking_id")

  subject     String
  description String
  category    SupportCategory @default(general)
  priority    SupportPriority @default(medium)
  status      SupportStatus   @default(open)

  customerEmail String  @map("customer_email")
  customerName  String  @map("customer_name")
  customerPhone String? @map("customer_phone")

  tags          String[] @default([])
  // internalNotes was [String] - free text an agent adds. Still an array of
  // strings; nothing queries inside it.
  internalNotes String[] @default([]) @map("internal_notes")

  firstResponseTime DateTime? @map("first_response_time")
  // A timestamp here, unlike Ticket.resolutionTime which is a number of minutes.
  // Same field name, different meaning, two different models.
  resolutionTime    DateTime? @map("resolution_time")
  resolvedAt        DateTime? @map("resolved_at")
  closedAt          DateTime? @map("closed_at")

  customerSatisfactionRating Int?    @map("customer_satisfaction_rating")
  customerFeedback           String? @map("customer_feedback") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([customerEmail])
  @@map("support_tickets")
}

enum SupportSender {
  customer
  agent

  @@map("support_sender")
}

// Was an embedded messages array on the ticket. A reply is an insert now rather
// than a rewrite of the whole ticket document, so two agents answering at once
// cannot lose each other's message.
model SupportTicketMessage {
  id          String        @id @default(uuid())
  ticketId    String        @map("ticket_id")
  sender      SupportSender
  senderName  String        @map("sender_name")
  senderId    String?       @map("sender_id")
  message     String        @db.VarChar(2000)
  attachments String[]      @default([])
  timestamp   DateTime      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, timestamp])
  @@map("support_ticket_messages")
}

enum ChatSessionStatus {
  active
  waiting_agent
  with_agent
  resolved
  closed

  @@map("chat_session_status")
}

model ChatSession {
  id        String @id @default(uuid())
  sessionId String @unique @map("session_id")

  userId    String? @map("user_id")
  userName  String? @map("user_name")
  userEmail String? @map("user_email")

  status ChatSessionStatus @default(active)

  // userContext was a nested blob of recent bookings, destinations and issues.
  // Nothing filters inside it, so it stays JSON rather than becoming four tables.
  userContext Json? @map("user_context")

  currentIntent   String?   @map("current_intent")
  lastActivity    DateTime  @default(now()) @map("last_activity")
  assignedAgentId String?   @map("assigned_agent_id")
  handoffReason   String?   @map("handoff_reason")
  handoffTime     DateTime? @map("handoff_time")
  agentJoinedTime DateTime? @map("agent_joined_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatSessionMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("chat_sessions")
}

enum ChatSender {
  user
  ai
  agent

  @@map("chat_sender")
}

// totalMessages was a counter beside the embedded array. It is a count of these
// rows now, for the same reason memberCount was dropped in wave 5.
model ChatSessionMessage {
  id        String     @id @default(uuid())
  sessionId String     @map("session_id")
  sender    ChatSender
  message   String     @db.VarChar(2000)
  timestamp DateTime   @default(now())

  isFromBot   Boolean  @default(false) @map("is_from_bot")
  agentId     String?  @map("agent_id")
  intent      String?
  confidence  Float?
  responseFor String?  @map("response_for")
  suggestions String[] @default([])

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("chat_session_messages")
}

enum ChatMessageSenderType {
  user
  organizer
  admin

  @@map("chat_message_sender_type")
}

enum ChatMessageType {
  text
  image
  file
  system

  @@map("chat_message_type")
}

enum ChatMessageRelatedType {
  trip
  booking
  ticket

  @@map("chat_message_related_type")
}

model ChatMessage {
  id             String                 @id @default(uuid())
  conversationId String                 @map("conversation_id")
  senderId       String                 @map("sender_id")
  senderType     ChatMessageSenderType  @map("sender_type")
  recipientId    String?                @map("recipient_id")
  recipientType  ChatMessageSenderType? @map("recipient_type")
  message        String
  messageType    ChatMessageType        @default(text) @map("message_type")
  attachments    Json                   @default("[]")
  isRead         Boolean                @default(false) @map("is_read")
  readAt         DateTime?              @map("read_at")

  // relatedTo was a nested { type, id }. Two columns, so "unread messages about
  // this booking" is a query rather than a scan through JSON.
  relatedToType ChatMessageRelatedType? @map("related_to_type")
  relatedToId   String?                 @map("related_to_id")

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isRead])
  @@map("chat_messages")
}

enum AiMessageRole {
  user
  assistant
  system

  @@map("ai_message_role")
}

// The Mongoose schema carried a second TTL index, on expiresAt with
// expireAfterSeconds 0 and expiresAt set 30 days ahead. Postgres has no TTL, so
// - as with audit_logs in wave 3 - the retention is a scheduled job.
// scripts/prune-expired.ts covers both, and it must actually be scheduled or
// these rows live forever.
model AIConversation {
  id        String  @id @default(uuid())
  sessionId String  @unique @map("session_id")
  userId    String? @map("user_id")

  startedAt         DateTime  @default(now()) @map("started_at")
  lastInteractionAt DateTime  @default(now()) @map("last_interaction_at")
  expiresAt         DateTime? @map("expires_at")

  // summary and context are read back whole by the assistant and never filtered
  // on, so they stay JSON.
  summary Json?
  context Json @default("{}")

  // escalation is different: the Mongoose schema indexed
  // { 'escalation.escalated': 1, 'escalation.assignedAgent': 1 } and the service
  // queries both, so these are columns. I had them as JSON first, which would
  // have turned "which escalations are unassigned" into a scan through documents.
  escalated         Boolean   @default(false)
  escalatedAt       DateTime? @map("escalated_at")
  escalationReason  String?   @map("escalation_reason")
  assignedAgentId   String?   @map("assigned_agent_id")

  // metrics was a nested object. messageCount is a count of the message rows now,
  // so it is not stored; the other three are values nothing derives.
  avgResponseTime  Float? @map("avg_response_time")
  userSatisfaction Int?   @map("user_satisfaction")
  aiConfidenceAvg  Float? @map("ai_confidence_avg")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AIConversationMessage[]

  @@index([userId, lastInteractionAt])
  @@index([expiresAt])
  @@index([escalated, assignedAgentId])
  @@map("ai_conversations")
}

// metrics.messageCount was a counter beside the array; it is a count of these.
model AIConversationMessage {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String        @db.VarChar(2000)
  timestamp      DateTime      @default(now())

  responseTime       Int?     @map("response_time")
  topic              String?
  requiresHumanAgent Boolean? @map("requires_human_agent")
  sender             String?
  metadata           Json     @default("{}")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("ai_conversation_messages")
}
