// ─────────────────────────────────────────────────────────────────────────────
// Wave 9: User
//
// The last model, and the one the other forty point at. 519 lines of Mongoose
// with six levels of nesting flatten to one wide table and three child tables.
//
// Three enums already in this schema describe exactly the values User uses, so
// they are reused rather than duplicated: ParticipantGender (the participant
// gender was copied off the user in the first place), PayoutKycStatus, and
// ExperienceLevel for the difficulty levels a traveller prefers.
//
// The foreign keys are NOT here. Every user id in the other tables is still a
// bare String column, and it stays that way until every writer is on Postgres -
// adding the constraints while something still writes users to Mongo would mean
// rows in Postgres with no parent. They land as their own migration, last.
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  traveler
  organizer
  admin
  agent

  @@map("user_role")
}

enum IdVerificationStatus {
  not_verified
  pending
  verified
  rejected

  @@map("id_verification_status")
}

enum IdDocumentType {
  aadhaar
  pan
  passport
  driving_license
  voter_id

  @@map("id_document_type")
}

enum ProfileVisibility {
  public
  private
  friends

  @@map("profile_visibility")
}

enum OrganizerVerificationStatus {
  pending
  approved
  rejected

  @@map("organizer_verification_status")
}

enum VerificationBadge {
  none
  bronze
  silver
  gold
  platinum

  @@map("verification_badge")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  username     String?  @unique
  role         UserRole @default(traveler)

  phone        String?
  bio          String?
  profilePhoto String?            @map("profile_photo")
  coverPhoto   String?            @map("cover_photo")
  location     String?
  dateOfBirth  DateTime?          @map("date_of_birth") @db.Date
  gender       ParticipantGender?
  occupation   String?
  uniqueUrl    String?            @unique @map("unique_url")

  // emergencyContact was a nested object whose three inner fields were required
  // while the object itself was optional - which means "either all three or
  // none", a rule Mongoose cannot state and a CHECK can.
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactRelationship String? @map("emergency_contact_relationship")
  emergencyContactPhone        String? @map("emergency_contact_phone")
  emergencyContactEmail        String? @map("emergency_contact_email")

  // travelStats. reviewCount and averageRating are maintained by a trigger off
  // the reviews table - they are counts of rows that exist, not numbers the
  // application is trusted to keep in step.
  tripsCompleted       Int      @default(0) @map("trips_completed")
  totalDistance        Float    @default(0) @map("total_distance")
  favoriteDestinations String[] @map("favorite_destinations")
  travelBadges         String[] @map("travel_badges")
  reviewCount          Int      @default(0) @map("review_count")
  averageRating        Decimal  @default(0) @map("average_rating") @db.Decimal(3, 2)

  // preferences. budgetRange was [Number] with a validator saying "exactly two
  // or empty" - two nullable columns say the same thing and cannot hold three.
  preferredCategories         String[]          @map("preferred_categories")
  budgetMin                   Decimal?          @map("budget_min") @db.Decimal(14, 2)
  budgetMax                   Decimal?          @map("budget_max") @db.Decimal(14, 2)
  preferredLocations          String[]          @map("preferred_locations")
  preferredDifficultyLevels   ExperienceLevel[] @map("preferred_difficulty_levels")
  preferredAccommodationTypes String[]          @map("preferred_accommodation_types")
  preferredTripDurations      String[]          @map("preferred_trip_durations")
  notifyEmail                 Boolean           @default(true) @map("notify_email")
  notifySms                   Boolean           @default(false) @map("notify_sms")
  notifyPush                  Boolean           @default(true) @map("notify_push")
  notifyTripUpdates           Boolean           @default(true) @map("notify_trip_updates")
  notifyPromotions            Boolean           @default(false) @map("notify_promotions")

  socialInstagram String? @map("social_instagram")
  socialFacebook  String? @map("social_facebook")
  socialTwitter   String? @map("social_twitter")
  socialLinkedin  String? @map("social_linkedin")
  socialWebsite   String? @map("social_website")

  // ── organizerProfile, flattened ────────────────────────────────────────────
  organizerBio          String?  @map("organizer_bio")
  organizerExperience   String?  @map("organizer_experience")
  specialties           String[]
  certifications        String[]
  languages             String[]
  yearsOfExperience     Int?     @map("years_of_experience")
  totalTripsOrganized   Int      @default(0) @map("total_trips_organized")
  organizerAchievements String[] @map("organizer_achievements")
  organizerUniqueUrl    String?  @unique @map("organizer_unique_url")
  companyName           String?  @map("company_name")
  licenseNumber         String?  @map("license_number")
  insuranceDetails      String?  @map("insurance_details")
  paymentQr             String?  @map("payment_qr")

  // autoPay. This one really was in the Mongoose schema and really does persist.
  autoPaySetupRequired    Boolean   @default(true) @map("auto_pay_setup_required")
  autoPaySetupCompleted   Boolean   @default(false) @map("auto_pay_setup_completed")
  autoPayFirstLoginDate   DateTime? @map("auto_pay_first_login_date")
  autoPaySetupCompletedAt DateTime? @map("auto_pay_setup_completed_at")
  autoPayScheduledDate    DateTime? @map("auto_pay_scheduled_date")
  autoPayAmount           Decimal?  @map("auto_pay_amount") @db.Decimal(14, 2)
  autoPayCustomerId       String?   @map("auto_pay_customer_id")
  autoPayMethodId         String?   @map("auto_pay_method_id")
  autoPayLastPaymentDate  DateTime? @map("auto_pay_last_payment_date")
  autoPayNextPaymentDate  DateTime? @map("auto_pay_next_payment_date")
  autoPayEnabled          Boolean   @default(false) @map("auto_pay_enabled")

  // ── The five that were never stored ────────────────────────────────────────
  //
  // trustScore, verificationBadge, routingEnabled, razorpayRouteId and
  // bankDetails were declared on the TypeScript interface but not on the
  // Mongoose schema. Every write typechecked and every write was discarded by
  // strict mode - verified against a real mongod, which kept bio and dropped
  // the rest, and did not even create the parent object on a dotted-path update.
  //
  // So: trust scores computed by admin.service.ts at three sites never
  // persisted; verification badges never persisted; the admin routing toggle
  // did nothing; and the routingService filter on trustScore.overall has matched
  // zero organizers for its entire life.
  //
  // As columns they simply work. bankDetails is the exception and is absent on
  // purpose - see the note below the model.
  trustScoreOverall        Decimal?           @map("trust_score_overall") @db.Decimal(5, 2)
  trustDocumentVerified    Decimal?           @map("trust_document_verified") @db.Decimal(5, 2)
  trustBankVerified        Decimal?           @map("trust_bank_verified") @db.Decimal(5, 2)
  trustExperienceYears     Decimal?           @map("trust_experience_years") @db.Decimal(5, 2)
  trustCompletedTrips      Decimal?           @map("trust_completed_trips") @db.Decimal(5, 2)
  trustUserReviews         Decimal?           @map("trust_user_reviews") @db.Decimal(5, 2)
  trustResponseTime        Decimal?           @map("trust_response_time") @db.Decimal(5, 2)
  trustRefundRate          Decimal?           @map("trust_refund_rate") @db.Decimal(5, 2)
  trustScoreLastCalculated DateTime?          @map("trust_score_last_calculated")
  verificationBadge        VerificationBadge? @map("verification_badge")
  routingEnabled           Boolean            @default(false) @map("routing_enabled")
  razorpayRouteId          String?            @map("razorpay_route_id")

  // ── verification ───────────────────────────────────────────────────────────
  //
  // emailVerificationOtp (the plaintext one) and emailVerificationExpiry (no
  // trailing s) are both gone. The first had no consumer at all; the second was
  // written by nothing and read by routes/emailVerification.ts, which therefore
  // reported "no active OTP" to every caller regardless of the truth.
  isVerified                  Boolean   @default(false) @map("is_verified")
  emailVerified               Boolean   @default(false) @map("email_verified")
  emailVerificationOtpHash    String?   @map("email_verification_otp_hash")
  emailVerificationExpires    DateTime? @map("email_verification_expires")
  emailVerificationAttempts   Int       @default(0) @map("email_verification_attempts")
  emailVerificationLastSentAt DateTime? @map("email_verification_last_sent_at")
  phoneVerified               Boolean   @default(false) @map("phone_verified")
  phoneVerificationOtpHash    String?   @map("phone_verification_otp_hash")
  phoneVerificationExpires    DateTime? @map("phone_verification_expires")
  phoneVerificationAttempts   Int       @default(0) @map("phone_verification_attempts")
  phoneVerificationLastSentAt DateTime? @map("phone_verification_last_sent_at")

  kycStatus             PayoutKycStatus @default(pending) @map("kyc_status")
  kycVerified           Boolean         @default(false) @map("kyc_verified")
  kycSubmittedAt        DateTime?       @map("kyc_submitted_at")
  kycApprovedAt         DateTime?       @map("kyc_approved_at")
  kycRejectionReason    String?         @map("kyc_rejection_reason")
  razorpayAccountId     String?         @map("razorpay_account_id")
  razorpayStakeholderId String?         @map("razorpay_stakeholder_id")

  idVerificationStatus IdVerificationStatus @default(not_verified) @map("id_verification_status")
  idDocumentType       IdDocumentType?      @map("id_document_type")
  idDocumentNumber     String?              @map("id_document_number")
  idDocumentFront      String?              @map("id_document_front")
  idDocumentBack       String?              @map("id_document_back")
  idVerified           Boolean              @default(false) @map("id_verified")
  idVerifiedAt         DateTime?            @map("id_verified_at")
  idExpiryDate         DateTime?            @map("id_expiry_date")
  idRejectionReason    String?              @map("id_rejection_reason")

  profileVisibility ProfileVisibility @default(public) @map("profile_visibility")
  showEmail         Boolean           @default(false) @map("show_email")
  showPhone         Boolean           @default(false) @map("show_phone")
  showLocation      Boolean           @default(true) @map("show_location")

  // socialStats. Wave 1 kept these as plain stored counters and said why: the
  // Follow rows had moved to Postgres but User had not, so a Mongo-side sort on
  // followersCount could not be answered by counting Postgres rows. Both sides
  // are here now, so they become what they always claimed to be - maintained by
  // triggers on follows and posts. The sort still needs a column; a column that
  // cannot drift is the whole point.
  followersCount Int @default(0) @map("followers_count")
  followingCount Int @default(0) @map("following_count")
  postsCount     Int @default(0) @map("posts_count")

  organizerVerificationStatus          OrganizerVerificationStatus? @map("organizer_verification_status")
  organizerVerificationSubmittedAt     DateTime?                    @map("organizer_verification_submitted_at")
  organizerVerificationApprovedAt      DateTime?                    @map("organizer_verification_approved_at")
  organizerVerificationApprovedBy      String?                      @map("organizer_verification_approved_by")
  organizerVerificationRejectedAt      DateTime?                    @map("organizer_verification_rejected_at")
  organizerVerificationRejectionReason String?                      @map("organizer_verification_rejection_reason")
  organizerVerificationReviewedBy      String?                      @map("organizer_verification_reviewed_by")

  reputationPoints    Int      @default(0) @map("reputation_points")
  reputationLevel     Int      @default(1) @map("reputation_level")
  reputationLevelName String   @default("Explorer") @map("reputation_level_name")
  reputationBadges    String[] @map("reputation_badges")

  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  firstOrganizerLogin  DateTime? @map("first_organizer_login")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  qrCodes               UserQrCode[]
  achievements          UserAchievement[]
  verificationDocuments UserVerificationDocument[]

  @@index([role, followersCount(sort: Desc)])
  @@index([location])
  @@map("users")
}

// bankDetails is deliberately not a column here.
//
// It was one of the five the Mongoose schema never declared, so the User copy
// has never held a single byte and there is nothing to migrate. Wave 7 already
// gave bank details a real home in organizer_payout_configs, with the account
// number encrypted and an IFSC CHECK on the code. Recreating a plaintext
// duplicate of an encrypted store, to hold data that does not exist, would be a
// strange thing to do on purpose.
//
// bankDetailsController and subscriptions.service read and write the User path
// today and silently lose everything. They move to organizer_payout_configs,
// which means bank details begin persisting for the first time.

// followers[] and following[] are gone: the Follow table replaced them in wave 1
// and nothing has written them since. activityLog[] is gone too - nothing has
// ever written it, anywhere in the codebase.

model UserQrCode {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  filename      String
  originalName  String   @map("original_name")
  path          String
  paymentMethod String   @default("UPI") @map("payment_method")
  description   String   @default("")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  isActive      Boolean  @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_qr_codes")
}

model UserAchievement {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  description String
  earnedAt    DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_achievements")
}

model UserVerificationDocument {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  filename     String
  originalName String   @map("original_name")
  path         String
  size         Int
  mimetype     String
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  verified     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_verification_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// Sprint 5 — bookings and operations
//
// O7 in the plan reads: "Per-participant records — every ops table keys to
// bookings.id. A party of four cannot split across two rooms."
//
// booking_participants already exists and holds one row per traveller, so the
// answer here is to key the per-person tables to the participant, not the
// booking. Rooms, transport seats, attendance, equipment and medical
// declarations are things that happen to a person; documents and checklists
// are things that happen to a booking; permits, equipment stock and the
// emergency plan are things that belong to a trip. Each table keys to whichever
// of those it actually describes.
//
// This is strictly more expressive than keying everything to the booking, and
// forecloses nothing - a party of four can be split across two rooms, or all
// put in one. O7 as a product question is still the user's to close; this is
// the engineering shape that does not make the wrong answer permanent.
// ═══════════════════════════════════════════════════════════════════════════

enum AccommodationKind {
  hotel
  homestay
  camp
  hostel
  guesthouse

  @@map("accommodation_kind")
}

model Accommodation {
  id     String @id @default(uuid())
  tripId String @map("trip_id")

  name    String
  kind    AccommodationKind @default(hotel)
  address String?
  phone   String?

  checkIn  DateTime? @map("check_in")
  checkOut DateTime? @map("check_out")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]

  @@index([tripId])
  @@map("accommodations")
}

model Room {
  id              String @id @default(uuid())
  accommodationId String @map("accommodation_id")

  label    String
  capacity Int
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accommodation Accommodation    @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  assignments   RoomAssignment[]

  @@index([accommodationId])
  @@map("rooms")
}

// Over-capacity warns and allows; a duplicate assignment is refused.
//
// Those are two different rules and they are held in two different places on
// purpose. "This person is already in a room" is a fact the database can settle
// - hence the unique constraint on the participant. "This room now holds five
// people in four beds" is a judgement the organiser may have a reason for at
// 11pm in a hill station, so it is a warning the API returns, not a constraint
// that stops the night.
model RoomAssignment {
  id            String @id @default(uuid())
  roomId        String @map("room_id")
  participantId String @map("participant_id")

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  room        Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId])
  @@index([roomId])
  @@map("room_assignments")
}

enum TransportMode {
  bus
  train
  flight
  cab
  self

  @@map("transport_mode")
}

model TransportSegment {
  id     String @id @default(uuid())
  tripId String @map("trip_id")

  mode          TransportMode
  operator      String?
  identifier    String?
  fromLocation  String        @map("from_location")
  toLocation    String        @map("to_location")
  departsAt     DateTime?     @map("departs_at")
  arrivesAt     DateTime?     @map("arrives_at")
  seatCapacity  Int?          @map("seat_capacity")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments TransportAssignment[]

  @@index([tripId])
  @@map("transport_segments")
}

model TransportAssignment {
  id            String  @id @default(uuid())
  segmentId     String  @map("segment_id")
  participantId String  @map("participant_id")
  seatLabel     String? @map("seat_label")

  segment     TransportSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  participant BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([segmentId, participantId])
  @@index([segmentId])
  @@map("transport_assignments")
}

model ChecklistTemplate {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  label       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isRequired  Boolean @default(false) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items BookingChecklistItem[]

  @@index([organizerId])
  @@map("checklist_templates")
}

// UNIQUE(booking_id, template_id) is the gate condition: toggling an item three
// times leaves one row, not three. The toggle is an upsert against this
// constraint rather than an insert, so the row count cannot climb no matter how
// many times the button is pressed or how many tabs are open.
model BookingChecklistItem {
  id         String @id @default(uuid())
  bookingId  String @map("booking_id")
  templateId String @map("template_id")

  isDone      Boolean   @default(false) @map("is_done")
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking  GroupBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([bookingId, templateId])
  @@index([bookingId])
  @@map("booking_checklist_items")
}

enum AttendanceState {
  present
  absent
  late
  excused

  @@map("attendance_state")
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  tripId        String   @map("trip_id")
  participantId String   @map("participant_id")
  onDate        DateTime @map("on_date") @db.Date

  state    AttendanceState @default(present)
  notes    String?
  markedBy String?         @map("marked_by")
  markedAt DateTime        @default(now()) @map("marked_at")

  participant BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, onDate])
  @@index([tripId, onDate])
  @@map("attendance_records")
}

model EquipmentItem {
  id     String @id @default(uuid())
  tripId String @map("trip_id")

  name         String
  totalUnits   Int     @default(0) @map("total_units")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments EquipmentAssignment[]

  @@index([tripId])
  @@map("equipment_items")
}

model EquipmentAssignment {
  id            String @id @default(uuid())
  equipmentId   String @map("equipment_id")
  participantId String @map("participant_id")

  units      Int       @default(1)
  issuedAt   DateTime  @default(now()) @map("issued_at")
  returnedAt DateTime? @map("returned_at")

  equipment   EquipmentItem      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  participant BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, participantId])
  @@index([participantId])
  @@map("equipment_assignments")
}

// Expiry is a date, never a stored status. The gate says an expired permit must
// read "expired" however it is stored - so it is stored one way only, as
// expires_on, and "expired" is derived from it. A status column beside the date
// would be a second source of truth that goes stale at midnight with nothing
// watching.
model Permit {
  id     String @id @default(uuid())
  tripId String @map("trip_id")

  name          String
  authority     String?
  referenceCode String?   @map("reference_code")
  issuedOn      DateTime? @map("issued_on") @db.Date
  expiresOn     DateTime? @map("expires_on") @db.Date
  documentUrl   String?   @map("document_url")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId])
  @@map("permits")
}

model EmergencyPlan {
  id     String @id @default(uuid())
  tripId String @unique @map("trip_id")

  nearestHospital     String?  @map("nearest_hospital")
  hospitalPhone       String?  @map("hospital_phone")
  hospitalDistanceKm  Decimal? @map("hospital_distance_km") @db.Decimal(6, 2)
  evacuationPlan      String?  @map("evacuation_plan")
  localAuthorityPhone String?  @map("local_authority_phone")
  notes               String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("emergency_plans")
}

// Exactly one subject. The CHECK is written in the migration because Prisma has
// no syntax for it, and it is a CHECK rather than three nullable columns left
// to convention because "a document about nothing" and "a document about a trip
// and a participant at once" are both unanswerable when someone later asks what
// this file is for.
model OpsDocument {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  tripId        String? @map("trip_id")
  bookingId     String? @map("booking_id")
  participantId String? @map("participant_id")

  title       String
  category    String?
  fileUrl     String  @map("file_url")
  fileName    String? @map("file_name")
  mimeType    String? @map("mime_type")
  sizeBytes   Int?    @map("size_bytes")
  uploadedBy  String? @map("uploaded_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId])
  @@index([bookingId])
  @@index([participantId])
  @@map("ops_documents")
}

model MedicalDeclaration {
  id            String @id @default(uuid())
  participantId String @unique @map("participant_id")

  hasConditions     Boolean   @default(false) @map("has_conditions")
  conditions        String?
  medications       String?
  allergies         String?
  bloodGroup        String?   @map("blood_group")
  physicianName     String?   @map("physician_name")
  physicianPhone    String?   @map("physician_phone")
  declaredAt        DateTime? @map("declared_at")
  declarationSigned Boolean   @default(false) @map("declaration_signed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participant BookingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("medical_declarations")
}

// Certifications expire the same way permits do, and for the same reason are
// stored as a date rather than a status.
model Certification {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  name          String
  issuingBody   String?   @map("issuing_body")
  referenceCode String?   @map("reference_code")
  issuedOn      DateTime? @map("issued_on") @db.Date
  expiresOn     DateTime? @map("expires_on") @db.Date
  documentUrl   String?   @map("document_url")
  verifiedAt    DateTime? @map("verified_at")
  verifiedBy    String?   @map("verified_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@map("certifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// Sprint 8 — team, roles and invites
//
// An organizer's staff are not a new kind of user. They are Users with a
// membership row against an organizer, which is what lets the same person work
// for two operators without two logins, and what makes "remove them" a single
// row change rather than an account deletion.
//
// trip_leader is the role the sprint gate cares about: a leader sees only the
// trips they are assigned to, and the gate insists that is enforced server-side
// and checked with a direct request rather than by whether the UI drew a link.
// ═══════════════════════════════════════════════════════════════════════════

enum TeamRole {
  owner
  manager
  trip_leader
  viewer

  @@map("team_role")
}

enum MembershipStatus {
  active
  suspended
  removed

  @@map("membership_status")
}

// One active membership per person per organizer, enforced by a partial unique
// index in the migration - Prisma has no syntax for a WHERE on a unique index,
// so @@unique cannot express it. It has to be partial: a person removed and
// re-hired must be able to have a second row, and a plain unique on
// (organizerId, userId) would refuse that forever.
model TeamMembership {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")
  userId      String @map("user_id")

  role   TeamRole         @default(viewer)
  status MembershipStatus @default(active)

  invitedBy String?   @map("invited_by")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  removedAt DateTime? @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments TripLeaderAssignment[]

  @@index([organizerId, status])
  @@index([userId])
  @@map("team_memberships")
}

// An invite carries a token and an expiry. Accepting clears the token and fills
// user_id, so the same link cannot be used twice: there is no token left to
// match on. Expiry is a timestamp and never a status - "expired" is derived,
// the same way permits work in Sprint 5, because a status column goes stale at
// midnight with nothing watching it.
model TeamInvite {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  email String
  role  TeamRole @default(viewer)

  // Null once accepted. The unique index is partial in the migration so that
  // several spent invites can coexist while a live token stays unique.
  token     String?   @unique
  expiresAt DateTime  @map("expires_at")

  invitedBy  String?   @map("invited_by")
  acceptedAt DateTime? @map("accepted_at")
  userId     String?   @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([email])
  @@map("team_invites")
}

// Which trips a trip_leader may see. Absence of a row is the whole access
// decision - there is no "all trips" flag a leader could be given by accident,
// and removing the row removes the access in the same statement.
model TripLeaderAssignment {
  id           String @id @default(uuid())
  membershipId String @map("membership_id")
  tripId       String @map("trip_id")

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  membership TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, tripId])
  @@index([tripId])
  @@map("trip_leader_assignments")
}

// Calendar pushes are keyed by (trip, provider) so a repeat push updates the
// row it already wrote instead of adding another. The sprint gate is "repeat
// calendar push updates, never duplicates"; the unique constraint is what makes
// that true even when two pushes race.
model CalendarSync {
  id       String @id @default(uuid())
  tripId   String @map("trip_id")
  provider String

  externalEventId String   @map("external_event_id")
  lastPushedAt    DateTime @default(now()) @map("last_pushed_at")
  lastPayloadHash String?  @map("last_payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tripId, provider])
  @@map("calendar_syncs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Sprint 7 — marketing and growth, minus anything that needs the discount floor
//
// coupons and discount_rules are absent. O1 asks for the floor as a number and
// the gate says it must be "enforced, not just displayed" - so the enforcement
// cannot be written before the number exists, and a coupon table without it
// would be the uncapped stacking the plan already warns about, sitting in the
// schema waiting to be used.
//
// Everything here carries its own gate condition and none of them touch price.
// ═══════════════════════════════════════════════════════════════════════════

// Banner status is derived from its window, never stored. The gate says so, and
// the reason is that a stored 'active' flag is wrong at exactly the moment it
// matters - the minute the window closes, with nothing watching. Two dates and
// a derivation cannot drift.
model Banner {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  title       String
  bodyText    String? @map("body_text")
  imageUrl    String? @map("image_url")
  linkUrl     String? @map("link_url")
  placement   String  @default("home")

  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  // Paused is a decision someone made; expired is arithmetic. Only the
  // decision is stored.
  isPaused Boolean @default(false) @map("is_paused")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId, startsAt])
  @@map("banners")
}

model Campaign {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  name    String
  channel String
  subject String?
  body    String?

  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  recipients   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@map("campaigns")
}

model Referral {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  code        String  @unique
  referrerId  String  @map("referrer_id")
  referredId  String? @map("referred_id")

  bookingId  String?   @map("booking_id")
  rewardedAt DateTime? @map("rewarded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([referrerId])
  @@map("referrals")
}

// A review request is sent once per booking and matched back when the review
// arrives. The gate is "matches reviews back and is idempotent" - so the unique
// key is the booking, and asking twice updates the one row rather than sending
// a second email to somebody who already got one.
model ReviewRequest {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")
  bookingId   String @unique @map("booking_id")
  tripId      String @map("trip_id")

  sentAt      DateTime  @default(now()) @map("sent_at")
  remindedAt  DateTime? @map("reminded_at")
  reminderCount Int     @default(0) @map("reminder_count")

  // Filled when the review lands. Null means still waiting, and that is the
  // whole state - there is no 'pending'/'complete' column to disagree with it.
  reviewId    String?   @unique @map("review_id")
  respondedAt DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([tripId])
  @@map("review_requests")
}

// Notes are append-only. The gate: adding one leaves earlier ones
// byte-identical. There is no update path in the service and no updated_at
// column here - a note carries the words someone wrote at a moment, and an
// editable note is a different thing that should be called something else.
//
// A correction is a new note, which is also how the trail stays honest when
// somebody wants an earlier one to have said something different.
model CustomerNote {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  // Exactly one subject, enforced by a CHECK in the migration - the same shape
  // as ops_documents in Sprint 5, for the same reason.
  leadId     String? @map("lead_id")
  bookingId  String? @map("booking_id")
  customerId String? @map("customer_id")

  body      String
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@index([bookingId, createdAt])
  @@index([customerId, createdAt])
  @@map("customer_notes")
}
