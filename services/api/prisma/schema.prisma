// ─── Subscriptions ────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  trial
  free_trial   @map("free-trial")
  starter
  basic
  pro
  professional
  premium
  enterprise

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  pending_payment
  active
  expired
  cancelled
  trial

  @@map("subscription_status")
}

enum PaymentRecordStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_record_status")
}

enum TripUsageStatus {
  active
  completed
  cancelled

  @@map("trip_usage_status")
}

enum SubscriptionNotificationType {
  trial_ending
  trial_ended
  payment_due
  payment_failed
  trips_exhausted
  subscription_renewed

  @@map("subscription_notification_type")
}

// tripsRemaining and totalPaid are both gone.
//
// tripsRemaining was stored and also recomputed in a pre-save hook as
// tripsPerCycle - tripsUsed, so the column only ever held a value the other two
// columns already determined - and only while something happened to save the
// document. It is computed in the mapper now.
//
// totalPaid was incremented by addPayment(). It is the sum of the completed
// payment rows, which is a query. CRMSubscription had the same field as a
// virtual, computed exactly that way, which is a fair sign of which of the two
// was right.
//
// The CHECK on trips_used <= trips_per_cycle is what makes useTripSlot safe.
// The Mongoose version read tripsRemaining, compared it to zero, incremented
// and saved; two trips created at once both read the same number and both got a
// slot. The port increments conditionally and lets the database refuse.
model OrganizerSubscription {
  id          String @id @default(uuid())
  organizerId String @unique @map("organizer_id")

  plan          SubscriptionPlan   @default(free_trial)
  planType      String?            @map("plan_type") // config id, e.g. 'PROFESSIONAL'
  status        SubscriptionStatus @default(pending_payment)
  isTrialActive Boolean            @default(false) @map("is_trial_active")

  crmAccess          Boolean  @default(false) @map("crm_access")
  crmBundleHasAccess Boolean  @default(false) @map("crm_bundle_has_access")
  crmBundlePrice     Decimal  @default(0) @map("crm_bundle_price") @db.Decimal(14, 2)
  crmBundleFeatures  String[] @map("crm_bundle_features")

  subscriptionStartDate DateTime? @map("subscription_start_date")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  trialStartDate        DateTime? @map("trial_start_date")
  trialEndDate          DateTime? @map("trial_end_date")
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")

  tripsPerCycle Int @default(5) @map("trips_per_cycle")
  tripsUsed     Int @default(0) @map("trips_used")

  pricePerCycle Decimal @default(1499) @map("price_per_cycle") @db.Decimal(14, 2)
  currency      String  @default("INR") @db.VarChar(3)

  lastPaymentDate DateTime? @map("last_payment_date")
  nextPaymentDue  DateTime? @map("next_payment_due")

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  autoRenew          Boolean  @default(false) @map("auto_renew")
  paymentMethodId    String?  @map("payment_method_id")
  // paymentMethodValid is in the Mongoose schema but not in its TypeScript
  // interface, so it was invisible to every consumer that used the typed model.
  paymentMethodValid Boolean? @map("payment_method_valid")

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments          SubscriptionPayment[]
  tripUsageHistory  SubscriptionTripUsage[]
  notificationsSent SubscriptionNotification[]

  @@index([status])
  @@index([status, nextPaymentDue])
  @@map("organizer_subscriptions")
}

// transactionId is unique across every subscription. Recording the same gateway
// transaction twice is what would make a total wrong, and the total is now a sum
// of these rows, so the constraint and the number it protects are the same thing.
model SubscriptionPayment {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("INR") @db.VarChar(3)
  paymentMethod  String              @map("payment_method")
  transactionId  String              @unique @map("transaction_id")
  paymentDate    DateTime            @default(now()) @map("payment_date")
  status         PaymentRecordStatus @default(pending)
  receiptUrl     String?             @map("receipt_url")

  subscription OrganizerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, paymentDate])
  @@index([subscriptionId, status])
  @@map("subscription_payments")
}

// One slot per trip. useTripSlot() pushed onto an array without looking, so a
// retried request spent two slots on one trip and the organizer paid for it.
model SubscriptionTripUsage {
  id             String          @id @default(uuid())
  subscriptionId String          @map("subscription_id")
  tripId         String          @map("trip_id")
  tripTitle      String          @map("trip_title")
  status         TripUsageStatus @default(active)
  createdAt      DateTime        @default(now()) @map("created_at")

  subscription OrganizerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, tripId])
  @@index([subscriptionId, createdAt])
  @@map("subscription_trip_usage")
}

model SubscriptionNotification {
  id             String                       @id @default(uuid())
  subscriptionId String                       @map("subscription_id")
  type           SubscriptionNotificationType
  message        String
  sentAt         DateTime                     @default(now()) @map("sent_at")

  subscription OrganizerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, sentAt])
  @@map("subscription_notifications")
}

// ─── CRM subscriptions ────────────────────────────────────────────────────────

enum CRMPlanType {
  trip_package_5
  trip_package_10
  trip_package_20
  trip_package_50
  crm_bundle
  trial

  @@map("crm_plan_type")
}

enum CRMSubscriptionStatus {
  active
  expired
  cancelled
  pending_payment

  @@map("crm_subscription_status")
}

// Prisma enum members cannot start with a digit; the stored values do, and they
// are what Mongo holds, so the names are prefixed and the values mapped back.
enum CRMPackageType {
  trips_5  @map("5_trips")
  trips_10 @map("10_trips")
  trips_20 @map("20_trips")
  trips_50 @map("50_trips")

  @@map("crm_package_type")
}

enum CRMPaymentAttemptStatus {
  attempted
  success
  failed

  @@map("crm_payment_attempt_status")
}

// Four nested objects flattened: tripPackage, crmBundle, trial and
// notifications. They were nested for grouping, not because anything queried
// them as a unit, and nesting is what let tripPackage.remainingTrips exist as a
// third number beside two that determine it.
// totalPaid was already a virtual here - the sum of completed payments - so it
// is not a column, exactly as before. OrganizerSubscription stored the same
// quantity and drifted; this model is the one that had it right.
//
// tripPackage.remainingTrips is gone for the same reason as tripsRemaining:
// totalTrips - usedTrips, with a CHECK so it cannot go negative.
model CRMSubscription {
  id          String                @id @default(uuid())
  organizerId String                @map("organizer_id")
  planType    CRMPlanType           @map("plan_type")
  status      CRMSubscriptionStatus @default(active)

  // tripPackage
  packageType     CRMPackageType @default(trips_5) @map("package_type")
  totalTrips      Int            @default(5) @map("total_trips")
  usedTrips       Int            @default(0) @map("used_trips")
  pricePerPackage Decimal        @default(1499) @map("price_per_package") @db.Decimal(14, 2)

  // crmBundle
  crmBundleHasAccess Boolean  @default(false) @map("crm_bundle_has_access")
  crmBundlePrice     Decimal  @default(2100) @map("crm_bundle_price") @db.Decimal(14, 2)
  crmBundleFeatures  String[] @map("crm_bundle_features")

  // trial
  trialIsActive        Boolean   @default(false) @map("trial_is_active")
  trialStartDate       DateTime? @map("trial_start_date")
  trialEndDate         DateTime? @map("trial_end_date")
  trialMonthsRemaining Int       @default(2) @map("trial_months_remaining")

  // notifications
  trialEndingIn7Days Boolean   @default(false) @map("trial_ending_in_7_days")
  trialEndingIn1Day  Boolean   @default(false) @map("trial_ending_in_1_day")
  trialExpired       Boolean   @default(false) @map("trial_expired")
  paymentReminder    Boolean   @default(false) @map("payment_reminder")
  lastReminderSentAt DateTime? @map("last_reminder_sent_at")

  startDate          DateTime  @default(now()) @map("start_date")
  endDate            DateTime? @map("end_date")
  expiryReminderSent Boolean   @default(false) @map("expiry_reminder_sent")

  autoRenew          Boolean   @default(false) @map("auto_renew")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments        CRMSubscriptionPayment[]
  paymentAttempts CRMPaymentAttempt[]
  billingHistory  CRMBillingEntry[]

  @@index([organizerId, createdAt])
  @@index([status])
  @@index([endDate])
  @@map("crm_subscriptions")
}

model CRMSubscriptionPayment {
  id                String              @id @default(uuid())
  subscriptionId    String              @map("subscription_id")
  razorpayOrderId   String?             @map("razorpay_order_id")
  razorpayPaymentId String?             @map("razorpay_payment_id")
  razorpaySignature String?             @map("razorpay_signature")
  transactionId     String              @unique @map("transaction_id")
  amount            Decimal             @db.Decimal(14, 2)
  currency          String              @default("INR") @db.VarChar(3)
  paymentMethod     String              @map("payment_method")
  status            PaymentRecordStatus @default(pending)
  paidAt            DateTime?           @map("paid_at")
  metadata          Json?

  subscription CRMSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("crm_subscription_payments")
}

// The Mongoose comment says these exist "for audit and retry idempotency", and
// attemptId is what would provide it - but nothing stopped two rows sharing one.
// Now nothing can, so a retried charge finds its own earlier attempt instead of
// writing a second one.
model CRMPaymentAttempt {
  id                String                  @id @default(uuid())
  subscriptionId    String                  @map("subscription_id")
  attemptId         String                  @unique @map("attempt_id")
  razorpayOrderId   String?                 @map("razorpay_order_id")
  razorpayPaymentId String?                 @map("razorpay_payment_id")
  amount            Decimal?                @db.Decimal(14, 2)
  status            CRMPaymentAttemptStatus @default(attempted)
  errorMessage      String?                 @map("error_message")
  createdAt         DateTime                @default(now()) @map("created_at")

  subscription CRMSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("crm_payment_attempts")
}

model CRMBillingEntry {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  date           DateTime @default(now())
  amount         Decimal  @db.Decimal(14, 2)
  description    String
  invoiceUrl     String?  @map("invoice_url")

  subscription CRMSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, date])
  @@map("crm_billing_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WAVE 8 - CORE
//
// Trip, GroupBooking and the verification models. This is the wave where the
// arrays that other models point at become tables, and where three bugs of the
// same shape come out:
//
//     (trip.participants as any[]).includes(userId)
//
// participants holds ObjectIds. `includes` compares with SameValueZero, so an
// ObjectId is never equal to a string, and two ObjectId instances holding the
// same value are not equal to each other either. That expression is false every
// time it is evaluated, in all three places it appears:
//
//   - cancelBookingByTripId: always throws "You are not booked for this trip",
//     so nobody can cancel through this route.
//   - getBookingDetailsByTripId: always 404s, so nobody can see their booking.
//   - verifyPayment and organizer.service: the guard against pushing a
//     participant who is already there never fires, so every payment
//     verification appends the same user again. The participant list grows, and
//     since capacity is checked against its length, the trip sells out early.
//
// One line further down the same file gets it right - `.filter(id =>
// id.toString() !== userId)` - which is what makes the other three readable as
// oversights rather than a misunderstanding.
//
// A row and a unique constraint make all three impossible.
// ═══════════════════════════════════════════════════════════════════════════════

enum TripDifficulty {
  easy
  moderate
  hard

  @@map("trip_difficulty")
}

enum TripRoutingStatus {
  pending_onboarding
  active
  main_account_fallback
  main_account
  error

  @@map("trip_routing_status")
}

enum TripStatus {
  pending
  active
  cancelled
  completed

  @@map("trip_status")
}

// Publication is a separate axis from lifecycle. TripStatus says what is
// happening to a trip - it is running, it was cancelled, it finished. This says
// whether the public can see it. Folding the two into one column would mean
// backfilling every existing trip to 'published' and losing which ones were
// cancelled or completed, on the most load-bearing table in the product.
enum TripPublicationStatus {
  draft
  scheduled
  published
  archived

  @@map("trip_publication_status")
}

enum TripApprovalStatus {
  pending
  approved
  rejected

  @@map("trip_approval_status")
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced

  @@map("experience_level")
}

enum TripPaymentType {
  full
  advance

  @@map("trip_payment_type")
}

enum TripStopKind {
  pickup
  dropoff

  @@map("trip_stop_kind")
}

// averageRating and reviewCount are maintained by a database trigger on the
// reviews table, not by the application.
//
// They were denormalized counters that whichever code path wrote a review was
// responsible for keeping in step - and Review moved to Postgres in wave 4,
// while Trip stayed in Mongo, so for the duration of this migration nothing
// could have kept them in step at all. Now both tables are in the same
// database, so the counters can be what they always claimed to be: a function
// of the reviews.
//
// A trigger rather than application code because the sort in routes/ai.ts is
// `ORDER BY average_rating DESC` over every trip - it needs a column, not a
// computed value - and because a counter maintained in one place cannot drift.
model Trip {
  id          String         @id @default(uuid())
  organizerId String         @map("organizer_id")
  title       String
  description String
  difficulty  TripDifficulty @default(moderate)
  categories  String[]
  destination String

  // location was a GeoJSON Point with a 2dsphere index. Nothing ever queried it
  // - no $near, no $geoWithin, anywhere in the codebase - so it was an index
  // maintained for queries that do not exist. Two columns, and PostGIS is not
  // needed until something actually asks a geographic question.
  longitude Float?
  latitude  Float?

  images                 String[]
  coverImage             String?   @map("cover_image")
  itinerary              String?
  itineraryPdf           String?   @map("itinerary_pdf")
  itineraryPdfFilename   String?   @map("itinerary_pdf_filename")
  itineraryPdfUploadedAt DateTime? @map("itinerary_pdf_uploaded_at")

  capacity   Int
  price      Decimal @db.Decimal(14, 2)
  minimumAge Int?    @map("minimum_age")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  status TripStatus @default(pending)

  averageRating Decimal @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount   Int     @default(0) @map("review_count")

  thumbnail String?

  verificationStatus TripApprovalStatus @default(pending) @map("verification_status")
  verifiedBy         String?            @map("verified_by")
  verifiedAt         DateTime?          @map("verified_at")
  rejectionReason    String?            @map("rejection_reason")
  adminNotes         String?            @map("admin_notes") @db.VarChar(1000)

  // ── paymentConfig, flattened ────────────────────────────────────────────────
  // collectionMode, verificationMode, manualProofRequired and trustLevel were
  // single-value enums with a comment explaining that TrekTribe carries the
  // liability and the values are therefore forced. A column that can only hold
  // one value is a comment with storage costs; the comment is kept and the
  // columns are not.
  paymentType         TripPaymentType @default(full) @map("payment_type")
  advanceAmount       Decimal?        @map("advance_amount") @db.Decimal(14, 2)
  paymentDueDate      DateTime?       @map("payment_due_date")
  refundPolicy        String?         @map("refund_policy")
  paymentMethods      String[]        @default(["upi"]) @map("payment_methods")
  paymentInstructions String?         @map("payment_instructions")

  gatewayQrAmount      Decimal?  @map("gateway_qr_amount") @db.Decimal(14, 2)
  gatewayQrCurrency    String?   @map("gateway_qr_currency") @db.VarChar(3)
  gatewayQrReferenceId String?   @map("gateway_qr_reference_id")
  gatewayQrUrl         String?   @map("gateway_qr_url")
  gatewayQrGeneratedAt DateTime? @map("gateway_qr_generated_at")

  // ── safetyInfo, flattened ───────────────────────────────────────────────────
  hasInsurance            Boolean  @default(false) @map("has_insurance")
  insuranceDetails        String?  @map("insurance_details")
  emergencyContactName    String?  @map("emergency_contact_name")
  emergencyContactPhone   String?  @map("emergency_contact_phone")
  medicalFacilitiesNearby String?  @map("medical_facilities_nearby")
  safetyEquipment         String[] @map("safety_equipment")
  covidProtocol           String?  @map("covid_protocol")

  // required: true AND a default, in the Mongoose schema. Carrying over the
  // NOT NULL without the default made every trip creation that did not send
  // one fail - which is every trip creation, because no caller sends it.
  safetyDisclaimer String @default("This trip involves physical activity and potential risks. Participants must be in good health and follow safety guidelines. The organizer is not liable for accidents, injuries, or loss of belongings. Travel insurance is recommended.") @map("safety_disclaimer")

  contentHash    String? @map("content_hash")
  isDuplicate    Boolean @default(false) @map("is_duplicate")
  originalTripId String? @map("original_trip_id")

  isPrivate      Boolean  @default(false) @map("is_private")
  allowedUserIds String[] @map("allowed_user_ids")

  slug String? @unique

  // ── Sprint 4: publication, series, templates, duplication ──────────────────
  //
  // publicationStatus defaults to draft so a newly created or duplicated trip
  // is never accidentally live. Existing rows are backfilled to published by
  // the migration, because they are already selling.
  //
  // duplicatedFromTripId is deliberately not originalTripId: that column and
  // isDuplicate belong to duplicateDetection.ts, which flags likely spam by
  // similarity score. Reusing it would conflate "someone copied this listing"
  // with "the organizer pressed Duplicate".
  publicationStatus    TripPublicationStatus @default(draft) @map("publication_status")
  publishAt            DateTime?             @map("publish_at")
  seriesId             String?               @map("series_id")
  templateId           String?               @map("template_id")
  duplicatedFromTripId String?               @map("duplicated_from_trip_id")

  series   TripSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  template TripTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // These five were written by the application and stored by nothing.
  //
  // setupPaymentRouting() assigns trip.paymentRoutingStatus, trip.paymentQR,
  // trip.paymentRouteId and trip.useMainRazorpayAccount and then saves; none of
  // the four are in the Mongoose schema, and Mongoose in strict mode - the
  // default - drops paths it does not know about. The whole routing state
  // machine has been writing into nothing. The same is true of
  // customRequestId, which routes/customTrips.ts sets when it converts a
  // proposal into a private trip, so the link back to the request that
  // produced it was never stored either.
  //
  // Nothing reads any of them, which is why nobody noticed. They are columns
  // now rather than deleted code: the intent is unambiguous in every case, and
  // a routing status that is recorded is worth more than five lines removed.
  paymentRoutingStatus   TripRoutingStatus? @map("payment_routing_status")
  paymentQrUrl           String?            @map("payment_qr_url")
  paymentRouteId         String?            @map("payment_route_id")
  useMainRazorpayAccount Boolean            @default(false) @map("use_main_razorpay_account")
  customRequestId        String?            @map("custom_request_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedule     TripScheduleDay[]
  packages     TripPackage[]
  stops        TripStop[]
  participants TripParticipant[]
  livePhotos   TripLivePhoto[]
  bookings     GroupBooking[]

  @@index([status, startDate])
  @@index([status, destination, startDate])
  @@index([organizerId, createdAt])
  @@index([organizerId, status])
  @@index([destination])
  @@index([price])
  @@index([difficulty])
  @@index([contentHash])
  @@index([isDuplicate])
  @@index([isPrivate])
  @@index([verificationStatus])
  @@index([averageRating, createdAt])
  @@map("trips")
}

// Was `participants: ObjectId[]` alongside a `participantDetails` array of the
// same people with more fields.
//
// participantDetails had no consumers at all - nothing wrote it and nothing
// read it, in the whole codebase - so it is one table, not two, and the fields
// that only existed on the unused half are carried here where they can actually
// be filled in.
//
// A template is not a trip. It holds the fields a trip would copy, in its own
// table, so it cannot appear in any query that reads `trips` - which is the
// sprint gate "templates never appear as trips", enforced by there being no row
// to find rather than by every listing query remembering to filter.
model TripTemplate {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  name        String
  title       String
  description String?
  destination String?
  difficulty  TripDifficulty @default(moderate)
  categories  String[]

  capacity   Int?
  price      Decimal? @db.Decimal(14, 2)
  durationDays Int?   @map("duration_days")

  itinerary       String?
  includedItems   String[] @map("included_items")
  excludedItems   String[] @map("excluded_items")
  safetyEquipment String[] @map("safety_equipment")

  timesUsed Int       @default(0) @map("times_used")
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips Trip[]

  @@index([organizerId])
  @@map("trip_templates")
}

// A series groups recurring departures of the same trip. Trips point at it;
// deleting a series leaves its trips standing (SetNull) because the departures
// are real and sold, and the grouping is only a convenience.
model TripSeries {
  id          String @id @default(uuid())
  organizerId String @map("organizer_id")

  name        String
  description String?

  recurrenceRule String?   @map("recurrence_rule")
  startsOn       DateTime? @map("starts_on")
  endsOn         DateTime? @map("ends_on")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips Trip[]

  @@index([organizerId])
  @@map("trip_series")
}

// @@unique([tripId, userId]) is the constraint that fixes the `includes` bug:
// joining a trip twice is refused by the database rather than by a comparison
// that never worked.
model TripParticipant {
  id     String @id @default(uuid())
  tripId String @map("trip_id")
  userId String @map("user_id")

  emergencyContactName  String?          @map("emergency_contact_name")
  emergencyContactPhone String?          @map("emergency_contact_phone")
  medicalConditions     String?          @map("medical_conditions")
  dietaryRestrictions   String?          @map("dietary_restrictions")
  experienceLevel       ExperienceLevel? @map("experience_level")
  specialRequests       String?          @map("special_requests")

  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId, joinedAt])
  @@map("trip_participants")
}

model TripScheduleDay {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  day        Int
  title      String
  activities String[]

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, day])
  @@map("trip_schedule_days")
}

// packageOptionSchema carried its own `id` string, generated by the application
// and unique only by convention. It is the key bookings reference by
// selectedPackageId, so it is unique per trip now.
model TripPackage {
  id          String   @id @default(uuid())
  tripId      String   @map("trip_id")
  packageKey  String   @map("package_key")
  name        String
  description String?
  price       Decimal  @db.Decimal(14, 2)
  capacity    Int
  inclusions  String[]
  exclusions  String[]
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, packageKey])
  @@index([tripId, sortOrder])
  @@map("trip_packages")
}

// pickupPoints and dropOffPoints were two arrays of identical shape. One table
// with a kind, because the difference between them was which array they were in
// and nothing else.
model TripStop {
  id            String       @id @default(uuid())
  tripId        String       @map("trip_id")
  kind          TripStopKind
  name          String
  address       String
  longitude     Float?
  latitude      Float?
  time          String?
  contactPerson String?      @map("contact_person")
  contactPhone  String?      @map("contact_phone")
  landmarks     String?
  instructions  String?
  sortOrder     Int          @default(0) @map("sort_order")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, kind, sortOrder])
  @@map("trip_stops")
}

// NOT CARRIED OVER: the Mongoose schema validated that a trip has at least one
// live photo once its startDate has passed. That is a condition on this table
// evaluated against a column on trips, which a CHECK cannot express - it would
// need a trigger, or a scheduled job that flags trips in breach.
//
// Nothing enforces it today, and nothing enforced it reliably before either:
// Mongoose validators run on save(), so a trip that started after its last
// save was never re-checked. Recording it here rather than pretending the rule
// survived the move.
//
// isThumbnail was a flag on each photo with "first uploaded photo is thumbnail"
// as the rule, maintained by whoever uploaded. A partial unique index makes at
// most one photo per trip the thumbnail; the rule is in the database.
model TripLivePhoto {
  id          String   @id @default(uuid())
  tripId      String   @map("trip_id")
  url         String
  filename    String
  caption     String?  @db.VarChar(200)
  location    String?
  isThumbnail Boolean  @default(false) @map("is_thumbnail")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, uploadedAt])
  @@map("trip_live_photos")
}

