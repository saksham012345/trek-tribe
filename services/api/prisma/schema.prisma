generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VendorCategory {
  hotel
  homestay
  campsite
  transport
  driver
  guide
  trek_leader
  equipment_rental
  food
  photographer
  videographer
  permit_agency
  emergency_contact
  custom

  @@map("vendor_category")
}

enum VendorAvailability {
  available
  busy
  unavailable

  @@map("vendor_availability")
}

model Vendor {
  id                  String             @id @default(uuid())
  organizerId         String             @map("organizer_id")
  businessName        String             @map("business_name")
  contactPerson       String?            @map("contact_person")
  phone               String?
  email                String?
  whatsappNumber      String?            @map("whatsapp_number")
  category            VendorCategory
  customCategoryLabel String?            @map("custom_category_label")
  address             String?
  gstNumber           String?            @map("gst_number")
  pricingNotes        String?            @map("pricing_notes")
  rating              Decimal?
  availabilityStatus  VendorAvailability @default(available) @map("availability_status")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  documents         VendorDocument[]
  assignments       TripVendorAssignment[]
  communicationLogs VendorCommunicationLog[]

  @@index([organizerId])
  @@map("vendors")
}

model VendorDocument {
  id         String   @id @default(uuid())
  vendorId   String   @map("vendor_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model TripVendorAssignment {
  id         String         @id @default(uuid())
  tripId     String         @map("trip_id")
  vendorId   String         @map("vendor_id")
  category   VendorCategory
  assignedAt DateTime       @default(now()) @map("assigned_at")

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payment VendorPayment?

  @@index([tripId])
  @@index([vendorId])
  @@map("trip_vendor_assignments")
}

enum VendorPaymentStatus {
  pending
  partial
  paid
  overdue

  @@map("vendor_payment_status")
}

model VendorPayment {
  id          String              @id @default(uuid())
  assignmentId String             @unique @map("assignment_id")
  totalAmount Decimal             @map("total_amount")
  paidAmount  Decimal             @default(0) @map("paid_amount")
  dueDate     DateTime?           @map("due_date")
  status      VendorPaymentStatus @default(pending)
  recordedAt  DateTime            @default(now()) @map("recorded_at")

  assignment TripVendorAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  history    VendorPaymentHistory[]

  @@map("vendor_payments")
}

model VendorPaymentHistory {
  id              String   @id @default(uuid())
  vendorPaymentId String   @map("vendor_payment_id")
  amount          Decimal
  paidAt          DateTime @default(now()) @map("paid_at")
  note            String?

  vendorPayment VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)

  @@index([vendorPaymentId])
  @@map("vendor_payment_history")
}

enum VendorEventType {
  vendor_payment_completed
  pre_departure_reminder

  @@map("vendor_event_type")
}

model VendorEvent {
  id          String          @id @default(uuid())
  tripId      String          @map("trip_id")
  eventType   VendorEventType @map("event_type")
  payload     Json
  createdAt   DateTime        @default(now()) @map("created_at")
  processedAt DateTime?       @map("processed_at")

  @@index([processedAt])
  @@map("vendor_events")
}

enum VendorCommunicationStatus {
  sent
  failed
  pending

  @@map("vendor_communication_status")
}

model VendorCommunicationLog {
  id            String                    @id @default(uuid())
  assignmentId  String?                   @map("assignment_id")
  vendorId      String                    @map("vendor_id")
  eventType     VendorEventType           @map("event_type")
  status        VendorCommunicationStatus @default(pending)
  sentAt        DateTime?                 @map("sent_at")
  emailSnapshot String                    @map("email_snapshot")
  createdAt     DateTime                  @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([assignmentId])
  @@map("vendor_communication_log")
}
