  completed

  @@map("booking_status")
}

enum BookingRefundStatus {
  pending
  processed
  failed

  @@map("booking_refund_status")
}

enum ParticipantGender {
  male
  female
  other
  prefer_not_to_say @map("prefer-not-to-say")

  @@map("participant_gender")
}

// The money on a booking is stored, not derived - a booking is a record of what
// was agreed, and recomputing it later from a price that has since changed would
// rewrite history.
//
// But it has to add up, and a pre-save hook recomputing four numbers on every
// save is not the same as it adding up. The CHECK constraints below say the
// arithmetic the hook was performing, so a booking whose parts disagree cannot
// be stored at all:
//
//     total_amount   = price_per_person * number_of_guests
//     discount_amount = total_amount * group_discount / 100
//     final_amount   = total_amount - discount_amount
//
// numberOfGuests and totalParticipants were two columns for one quantity - the
// model comment says "same as totalParticipants but clearer naming" - and the
// hook set one from the other while the money was computed from whichever
// happened to be set. There is one now.
model GroupBooking {
  id           String @id @default(uuid())
  tripId       String @map("trip_id")
  mainBookerId String @map("main_booker_id")

  numberOfGuests    Int     @map("number_of_guests")
  selectedPackageId String? @map("selected_package_id")
  packageName       String? @map("package_name")

  totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 2)
  pricePerPerson Decimal  @map("price_per_person") @db.Decimal(14, 2)
  groupDiscount  Decimal  @default(0) @map("group_discount") @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(14, 2)
  paidAmount     Decimal? @map("paid_amount") @db.Decimal(14, 2)

  paymentType     TripPaymentType @default(full) @map("payment_type")
  advanceAmount   Decimal?        @map("advance_amount") @db.Decimal(14, 2)
  remainingAmount Decimal?        @map("remaining_amount") @db.Decimal(14, 2)

  paymentStatus        BookingPaymentStatus @default(pending) @map("payment_status")
  paymentMethod        String               @map("payment_method")
  paymentTransactionId String?              @map("payment_transaction_id")
  razorpayOrderId      String?              @map("razorpay_order_id")
  razorpayPaymentId    String?              @unique @map("razorpay_payment_id")

  // paymentDetails, flattened
  transactionDate      DateTime? @map("transaction_date")
  paymentGateway       String?   @map("payment_gateway")
  gatewayTransactionId String?   @map("gateway_transaction_id")
  paymentReference     String?   @map("payment_reference")

  // paymentScreenshot, flattened
  screenshotFilename     String?   @map("screenshot_filename")
  screenshotOriginalName String?   @map("screenshot_original_name")
  screenshotUrl          String?   @map("screenshot_url")
  screenshotUploadedAt   DateTime? @map("screenshot_uploaded_at")

  paymentVerificationStatus BookingVerificationStatus @default(pending) @map("payment_verification_status")
  paymentVerificationNotes  String?                   @map("payment_verification_notes")
  verifiedBy                String?                   @map("verified_by")
  verifiedAt                DateTime?                 @map("verified_at")
  verificationNotes         String?                   @map("verification_notes")
  rejectionReason           String?                   @map("rejection_reason")

  bookingStatus      BookingStatus        @default(pending) @map("booking_status")
  specialRequests    String?              @map("special_requests")
  notes              String?
  cancellationReason String?              @map("cancellation_reason")
  cancellationDate   DateTime?            @map("cancellation_date")
  refundAmount       Decimal?             @map("refund_amount") @db.Decimal(14, 2)
  refundStatus       BookingRefundStatus? @map("refund_status")

  // reminders was a nested object with one field in it.
  tripStart24hSentAt DateTime? @map("trip_start_24h_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participants BookingParticipant[]

  // Sprint 5 — checklists are per booking, not per person: they track what the
  // organiser needs from the party as a whole.
  checklistItems BookingChecklistItem[]

  @@unique([mainBookerId, tripId])
  @@index([tripId, createdAt])
  @@index([mainBookerId, createdAt])
  @@index([paymentStatus, bookingStatus])
  @@index([paymentVerificationStatus])
  @@map("group_bookings")
}

// "Exactly one main booker" was maintained by a pre-save hook that promoted
// participants[0] when none was marked, and by transferMainBooker flipping two
// flags one after the other with nothing holding them together. A partial
// unique index on (booking_id) WHERE is_main_booker says it instead, so a
// transfer that half-finished cannot leave two.
model BookingParticipant {
  id        String @id @default(uuid())
  bookingId String @map("booking_id")

  name  String
  email String
  phone String

  dateOfBirth DateTime?          @map("date_of_birth")
  gender      ParticipantGender?

  emergencyContactName  String          @map("emergency_contact_name")
  emergencyContactPhone String          @map("emergency_contact_phone")
  medicalConditions     String?         @map("medical_conditions")
  dietaryRestrictions   String?         @map("dietary_restrictions")
  experienceLevel       ExperienceLevel @map("experience_level")
  specialRequests       String?         @map("special_requests")
  isMainBooker          Boolean         @default(false) @map("is_main_booker")

  booking GroupBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Sprint 5 — the per-person operations records. These key here rather than to
  // the booking, which is what lets a party of four split across two rooms.
  roomAssignment       RoomAssignment?
  transportAssignments TransportAssignment[]
  attendanceRecords    AttendanceRecord[]
  equipmentAssignments EquipmentAssignment[]
  medicalDeclaration   MedicalDeclaration?

  @@unique([bookingId, email])
  @@index([bookingId])
  @@map("booking_participants")
}

