enum AiMessageRole {
  user
  assistant
  system

  @@map("ai_message_role")
}

// The Mongoose schema carried a second TTL index, on expiresAt with
// expireAfterSeconds 0 and expiresAt set 30 days ahead. Postgres has no TTL, so
// - as with audit_logs in wave 3 - the retention is a scheduled job.
// scripts/prune-expired.ts covers both, and it must actually be scheduled or
// these rows live forever.
model AIConversation {
  id        String  @id @default(uuid())
  sessionId String  @unique @map("session_id")
  userId    String? @map("user_id")

  startedAt         DateTime  @default(now()) @map("started_at")
  lastInteractionAt DateTime  @default(now()) @map("last_interaction_at")
  expiresAt         DateTime? @map("expires_at")

  // summary and context are read back whole by the assistant and never filtered
  // on, so they stay JSON.
  summary Json?
  context Json  @default("{}")

  // escalation is different: the Mongoose schema indexed
  // { 'escalation.escalated': 1, 'escalation.assignedAgent': 1 } and the service
  // queries both, so these are columns. I had them as JSON first, which would
  // have turned "which escalations are unassigned" into a scan through documents.
  escalated        Boolean   @default(false)
  escalatedAt      DateTime? @map("escalated_at")
  escalationReason String?   @map("escalation_reason")
  assignedAgentId  String?   @map("assigned_agent_id")

  // metrics was a nested object. messageCount is a count of the message rows now,
  // so it is not stored; the other three are values nothing derives.
  avgResponseTime  Float? @map("avg_response_time")
  userSatisfaction Int?   @map("user_satisfaction")
  aiConfidenceAvg  Float? @map("ai_confidence_avg")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AIConversationMessage[]

  @@index([userId, lastInteractionAt])
  @@index([expiresAt])
  @@index([escalated, assignedAgentId])
  @@map("ai_conversations")
}

// metrics.messageCount was a counter beside the array; it is a count of these.
model AIConversationMessage {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String        @db.VarChar(2000)
  timestamp      DateTime      @default(now())

  responseTime       Int?     @map("response_time")
  topic              String?
  requiresHumanAgent Boolean? @map("requires_human_agent")
  sender             String?
  metadata           Json     @default("{}")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("ai_conversation_messages")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WAVE 7 - MONEY
//
// Every amount here is Decimal, not Float. The Mongoose schemas all said Number,
// which in Postgres would be double precision, and money in binary floating point
// is wrong in a way that only shows up once: a total that is off by a paisa and
// cannot be explained. Decimal(14,2) holds every amount this system deals in
// (marketplace amounts are integer paise; subscriptions and expenses are rupees)
// and adds exactly.
//
// The cost is that Prisma hands back Decimal objects, so `a + b` on two amounts
// would concatenate strings rather than add. Consumers convert at the boundary -
// see src/lib/money.ts.
// ═══════════════════════════════════════════════════════════════════════════════

enum ExpenseCategory {
  transport
  stay
  food
  guide
  permits
  marketing
  platform_fee
  miscellaneous

  @@map("expense_category")
}

model Expense {
  id          String          @id @default(uuid())
  organizerId String          @map("organizer_id")
  tripId      String          @map("trip_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  description String?         @db.VarChar(500)
  date        DateTime        @default(now())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tripId, category])
  @@index([organizerId, date])
  @@map("expenses")
}

enum LedgerEntryType {
  credit
  debit

  @@map("ledger_entry_type")
}

enum LedgerSource {
  order
  transfer
  refund
  adjustment

  @@map("ledger_source")
}

// The ledger is the record of what an organizer is owed, so an entry written
// twice is money counted twice. It was being written twice: razorpayRouteService
// .createTransfer() credits the payout when the transfer is created, and the
// transfer.processed webhook credits the same payoutAmount again when Razorpay
// confirms it. Same for refunds - initiateRefund() debits, refund.processed
// debits again.
//
// @@unique([source, referenceId, type]) makes the second write impossible: one
// credit per transfer id, one debit per refund id. The callers treat P2002 as
// "already recorded" rather than as an error, which is what they meant all along.
//
// referenceId is required for that reason. Adjustments, which have no external
// id, get one from the caller.
model PayoutLedger {
  id          String          @id @default(uuid())
  organizerId String          @map("organizer_id")
  type        LedgerEntryType
  source      LedgerSource
  referenceId String          @map("reference_id")
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("INR") @db.VarChar(3)
  description String?

  // balanceAfter was on the Mongoose model and no caller ever set it, so every
  // document had it undefined and nothing read it. Not carried over: a running
  // balance that is never written is worse than no column, because the next
  // person to read the schema believes there is one.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([source, referenceId, type])
  @@index([organizerId, createdAt])
  @@map("payout_ledger")
}

enum MarketplaceOrderStatus {
  created
  paid
  failed
  refunded
  partial_refund

  @@map("marketplace_order_status")
}

enum SplitStatus {
  pending
  processed
  failed

  @@map("split_status")
}

enum OrderRefundStatus {
  none
  requested
  processed
  partial

  @@map("order_refund_status")
}

model MarketplaceOrder {
  id          String                 @id @default(uuid())
  orderId     String                 @unique @map("order_id") // Razorpay order id
  paymentId   String?                @unique @map("payment_id")
  userId      String                 @map("user_id")
  organizerId String                 @map("organizer_id")
  tripId      String?                @map("trip_id")
  amount      Decimal                @db.Decimal(14, 2)
  currency    String                 @default("INR") @db.VarChar(3)
  notes       Json?
  status      MarketplaceOrderStatus @default(created)

  commissionAmount      Decimal @default(0) @map("commission_amount") @db.Decimal(14, 2)
  commissionRate        Decimal @default(5) @map("commission_rate") @db.Decimal(5, 2)
  organizerPayoutAmount Decimal @default(0) @map("organizer_payout_amount") @db.Decimal(14, 2)
  razorpayFeeAmount     Decimal @default(0) @map("razorpay_fee_amount") @db.Decimal(14, 2)

  splitStatus  SplitStatus       @default(pending) @map("split_status")
  refundStatus OrderRefundStatus @default(none) @map("refund_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

