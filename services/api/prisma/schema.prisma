  fileSize    Int            @map("file_size")
  fileType    ImportFileType @map("file_type")
  uploadedAt  DateTime       @default(now()) @map("uploaded_at")
  status      ImportStatus   @default(pending)

  statsTotalRecords      Int  @default(0) @map("stats_total_records")
  statsSuccessfulImports Int  @default(0) @map("stats_successful_imports")
  statsFailedImports     Int  @default(0) @map("stats_failed_imports")
  statsDuplicatesSkipped Int  @default(0) @map("stats_duplicates_skipped")
  // Milliseconds the run took. Nullable, because a job still in flight has not
  // taken any time yet.
  statsProcessingTime    Int? @map("stats_processing_time")

